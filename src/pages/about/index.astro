---
import Layout from '../../layouts/Layout.astro'
import AssignmentDiagram from '../../components/AssignmentDiagram.astro'
import profileImage from '../../assets/profiled.jpg'

const employment = {
    index: '01',
    period: '2021 — Present',
    role: 'Software Engineer / Full Stack',
    project: 'Defijn',
    mode: 'Agency delivery',
    premise: 'Ship useful software while improving the system that ships it.',
    points: [
        'Delivered SaaS work for multiple clients from ideation through implementation.',
        'Balanced TypeScript feature delivery, production support, and fast-moving client requests.',
        'Reviewed pull requests, strengthened security and reliability, and surfaced engineering friction.',
    ],
    tags: ['TypeScript', 'Client delivery', 'Code quality'],
}
const assignments = [
    {
        index: '06',
        period: 'Feb 2026 — Present',
        role: 'Full Stack Developer',
        project: 'Property appraisal platform',
        mode: 'Integration reliability',
        premise: 'Strengthen the connections behind a long-running workflow.',
        points: [
            'Took ownership of backend-focused enhancements and workflow stability.',
            'Implemented request flows and synchronisation to a low-code database for document export.',
            'Connected embedded intake forms, backend services, and templated generation processes.',
        ],
        tags: ['Backend', 'Integrations', 'Workflow'],
    },
    {
        index: '05',
        period: 'Nov 2025 — Jan 2026',
        role: 'Full Stack Developer',
        project: 'Invoice matching system',
        mode: 'Operational workflow',
        premise: 'Make high-density finance work feel controlled, not crowded.',
        points: [
            'Built and refined invoice-matching views for dense tabular data.',
            'Worked across frontend and backend to preserve accuracy and responsive behavior.',
            'Improved client workflows through interface and performance optimisation.',
        ],
        tags: ['Full stack', 'Dense data', 'Performance'],
    },
    {
        index: '04',
        period: 'Aug 2025 — Nov 2025',
        role: 'Frontend Developer',
        project: 'Carbon credit visualisation',
        mode: 'Data interface',
        premise: 'Give a difficult dataset an immediately readable shape.',
        points: [
            'Developed a bespoke bubble graph for UK carbon-credit issuance.',
            'Created sorting and categorisation logic to improve comparison.',
            'Built contextual detail views for each issuing entity.',
        ],
        tags: ['Data visualisation', 'Interaction', 'UI'],
    },
    {
        index: '03',
        period: 'Jun 2025 — Dec 2025',
        role: 'QA Engineer',
        project: 'Automation and reliability',
        mode: 'Quality systems',
        premise:
            'Turn release confidence into something the whole team can see.',
        points: [
            'Combined manual regression coverage with automated Playwright journeys.',
            'Integrated tests, videos, and failure artifacts into GitHub Actions.',
            'Added Sentry, uptime alerts, service-health reporting, and email-delivery monitoring.',
        ],
        tags: ['Playwright', 'CI/CD', 'Sentry'],
    },
    {
        index: '02',
        period: 'Jul 2021 — Jun 2025',
        role: 'Frontend Developer',
        project: 'Investment research platform',
        mode: 'Data + realtime',
        premise: 'Make complex, fast-moving information useful at a glance.',
        points: [
            'Built React and TypeScript product surfaces for aggregated financial data and news.',
            'Implemented REST integrations and realtime WebSocket notifications.',
            'Translated complex data into clear UI and iterated directly from stakeholder feedback.',
        ],
        tags: ['React', 'REST', 'WebSockets'],
    },
]
---

<Layout
    title="About | Daniel Vieira Teixeira"
    description="Meet Daniel Vieira Teixeira, a full-stack software engineer in Cape Town. Explore his background and frontend, backend, quality, and reliability experience at Defijn."
    canonical="https://dvieira.dev/about"
>
    <main class="about">
        <div class="about-intro">
            <header class="identity">
                <h1>
                    About <em
                        >Daniel<span class="name-rule" aria-hidden="true"
                        ></span></em
                    >
                </h1>
                <figure class="portrait">
                    <img
                        src={profileImage.src}
                        width="144"
                        height="144"
                        alt="Portrait of Daniel Vieira Teixeira"
                        decoding="async"
                    />
                    <figcaption>
                        <strong>Daniel Vieira Teixeira</strong>
                        <span>Full Stack Software Engineer</span>
                        <span>Cape Town, South Africa</span>
                    </figcaption>
                </figure>
                <a class="text-action experience-link" href="#experience">
                    View experience
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 3v18m-7-7 7 7 7-7"></path>
                    </svg>
                </a>
            </header>
            <section class="description" aria-labelledby="story-title">
                <h2 id="story-title">A wider view of the system.</h2>
                <div class="story-copy">
                    <p>
                        I'm Daniel Vieira Teixeira, a full-stack software
                        engineer with more than five years of experience
                        building SaaS products in fast-moving, client-facing
                        teams.
                    </p>
                    <p>
                        <strong class="range-statement"
                            >My foundation is TypeScript. My value is range:</strong
                        >
                        responsive React interfaces, backend integrations, real-time
                        features, automated testing, CI quality gates, observability,
                        and the production work that keeps a useful product useful.
                    </p>
                    <p>
                        I like assignments where the brief is still tangled. I
                        clarify the constraint, find the layer with the most
                        leverage, and move between disciplines until the system
                        behaves better for the people who depend on it.
                    </p>
                </div>
            </section>
        </div>

        <section class="experience-section" aria-labelledby="experience">
            <h2 id="experience">Experience</h2>
            <article
                id="project-01"
                class="employment"
                aria-labelledby="employer-title"
            >
                <header class="employment-meta">
                    <h3 id="employer-title">{employment.project}</h3>
                    <p class="role">{employment.role}</p>
                    <p class="period">{employment.period}</p>
                    <p class="mode">{employment.mode}</p>
                </header>
                <div class="employment-detail">
                    <p class="premise">{employment.premise}</p>
                    <ul class="contributions">
                        {employment.points.map(point => <li>{point}</li>)}
                    </ul>
                    <ul class="tags" aria-label="Areas of work">
                        {employment.tags.map(tag => <li>{tag}</li>)}
                    </ul>
                </div>
            </article>

            <section class="assignments" aria-labelledby="assignments-title">
                <h3 id="assignments-title">Selected assignments at Defijn</h3>
                <ol class="timeline" role="list">
                    {
                        assignments.map(item => (
                            <li
                                id={`project-${item.index}`}
                                class="timeline-entry"
                            >
                                <span class="timeline-track" aria-hidden="true">
                                    <span class="timeline-trace" />
                                </span>
                                <span
                                    class="timeline-marker"
                                    aria-hidden="true"
                                />
                                <div class="assignment-meta">
                                    <p class="period">{item.period}</p>
                                    <p class="mode">{item.mode}</p>
                                </div>
                                <article
                                    class="assignment"
                                    aria-labelledby={`title-${item.index}`}
                                >
                                    <header>
                                        <h4 id={`title-${item.index}`}>
                                            {item.project}
                                        </h4>
                                        <p class="role">{item.role}</p>
                                    </header>
                                    <p class="premise">{item.premise}</p>
                                    {item.index === '06' && (
                                        <AssignmentDiagram kind="integration" />
                                    )}
                                    {item.index === '05' && (
                                        <AssignmentDiagram kind="matching" />
                                    )}
                                    <ul class="contributions">
                                        {item.points.map(point => (
                                            <li>{point}</li>
                                        ))}
                                    </ul>
                                    <ul class="tags" aria-label="Areas of work">
                                        {item.tags.map(tag => (
                                            <li>{tag}</li>
                                        ))}
                                    </ul>
                                </article>
                            </li>
                        ))
                    }
                </ol>
            </section>
        </section>

        <footer class="about-cta">
            <p>Have a complicated product problem?</p>
            <a class="text-action contact-stamp" href="/contact">
                Let's untangle it
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 12h18m-7-7 7 7-7 7"></path>
                </svg>
            </a>
        </footer>
    </main>
</Layout>

<script>
    import { gsap } from 'gsap'
    import { ScrollTrigger } from 'gsap/ScrollTrigger'

    gsap.registerPlugin(ScrollTrigger)

    let disposeMotion: (() => void) | undefined
    let nameSigned = false

    function initAboutMotion(): void {
        disposeMotion?.()
        const root = document.querySelector<HTMLElement>('.about')
        if (!root) return

        let active = true
        const media = gsap.matchMedia()
        const context = gsap.context(() => {
            media.add(
                '(prefers-reduced-motion: no-preference)',
                () => {
                    const name = root.querySelector<HTMLElement>('h1 em')
                    if (!nameSigned && name) {
                        nameSigned = true
                        const bounds = name.getBoundingClientRect()
                        // Deep links and restored scroll positions skip the signature.
                        if (
                            !location.hash &&
                            bounds.top >= 0 &&
                            bounds.bottom <= innerHeight
                        ) {
                            gsap.fromTo(
                                '.name-rule',
                                { scaleX: 0 },
                                {
                                    scaleX: 1,
                                    duration: 0.7,
                                    ease: 'expo.out',
                                    clearProps: 'transform',
                                },
                            )
                        }
                    }

                    root.querySelectorAll<HTMLElement>(
                        '.timeline-entry',
                    ).forEach(entry => {
                        const trace =
                            entry.querySelector<HTMLElement>('.timeline-trace')
                        if (trace && entry.nextElementSibling)
                            gsap.fromTo(
                                trace,
                                { scaleY: 0 },
                                {
                                    scaleY: 1,
                                    ease: 'none',
                                    scrollTrigger: {
                                        trigger:
                                            entry.querySelector(
                                                '.timeline-track',
                                            ),
                                        start: 'top 65%',
                                        end: 'bottom 65%',
                                        scrub: true,
                                    },
                                },
                            )
                        gsap.fromTo(
                            entry,
                            { '--marker-progress': 0 },
                            {
                                '--marker-progress': 1,
                                ease: 'none',
                                scrollTrigger: {
                                    trigger:
                                        entry.querySelector('.timeline-marker'),
                                    start: 'top 70%',
                                    end: 'top 60%',
                                    scrub: true,
                                },
                            },
                        )
                    })
                },
                root,
            )
            media.add(
                '(min-width: 761px) and (prefers-reduced-motion: no-preference)',
                () => {
                    root.querySelectorAll<HTMLElement>(
                        '[data-diagram]',
                    ).forEach(diagram => {
                        const sequence = gsap.timeline({
                            scrollTrigger: {
                                trigger: diagram,
                                start: 'top 85%',
                                once: true,
                            },
                        })
                        const rows = diagram.querySelectorAll(
                            '[data-matching-row]',
                        )
                        if (rows.length) {
                            sequence.from(rows, {
                                y: index => (index === 0 ? -6 : 6),
                                duration: 0.3,
                                ease: 'power2.out',
                                clearProps: 'transform',
                            })
                        }
                        sequence.fromTo(
                            diagram.querySelectorAll('[data-diagram-trace]'),
                            { strokeDashoffset: 1 },
                            {
                                strokeDashoffset: 0,
                                duration: 0.4,
                                ease: 'power2.out',
                            },
                        )
                    })
                },
                root,
            )
            media.add(
                '(prefers-reduced-motion: reduce)',
                () => {
                    nameSigned = true
                },
                root,
            )
        }, root)

        void document.fonts.ready.then(() => {
            if (active && root.isConnected) ScrollTrigger.refresh(true)
        })
        disposeMotion = () => {
            active = false
            media.revert()
            context.revert()
            disposeMotion = undefined
        }
    }

    function cleanupAboutMotion(): void {
        disposeMotion?.()
    }

    document.addEventListener('astro:page-load', initAboutMotion)
    document.addEventListener('astro:before-swap', cleanupAboutMotion)

    if (import.meta.hot) {
        import.meta.hot.dispose(() => {
            cleanupAboutMotion()
            document.removeEventListener('astro:page-load', initAboutMotion)
            document.removeEventListener(
                'astro:before-swap',
                cleanupAboutMotion,
            )
        })
    }
</script>

<style lang="scss">
    .about {
        background: var(--paper);
    }

    .about [id] {
        scroll-margin-top: 2rem;
    }

    .about-intro {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
        gap: clamp(2.5rem, 5vw, 5rem);
        padding: clamp(2.5rem, 5vw, 5rem) var(--page-gutter);
        border-bottom: 1px solid var(--ink);
        background: var(--heritage-cream);
    }

    h1 {
        font-size: clamp(3.5rem, 6vw, 6rem);
        font-variation-settings:
            'wdth' 74,
            'wght' 330;
        letter-spacing: -0.04em;
        line-height: 0.95;
    }

    h1 em {
        position: relative;
        display: block;
        width: fit-content;
        color: var(--heritage-amber-ink);
        font-family: var(--font-human);
        font-weight: 670;
    }

    .name-rule {
        position: absolute;
        right: 0;
        bottom: -0.06em;
        left: 0;
        height: 2px;
        background: var(--heritage-amber-ink);
        transform-origin: left;
        pointer-events: none;
    }

    .portrait {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.25rem;
        margin-top: 2rem;
    }

    .portrait img {
        width: clamp(5rem, 8vw, 7rem);
        height: auto;
        aspect-ratio: 1;
        border: 3px solid var(--heritage-cream);
        border-radius: 50%;
        outline: 1px solid var(--heritage-amber-ink);
        object-fit: cover;
        filter: grayscale(1) contrast(1.06);
        box-shadow: 5px 5px 0 var(--heritage-amber);
    }

    figcaption {
        display: grid;
        gap: 0.4rem;
        max-width: 25ch;
    }

    figcaption strong {
        font-family: var(--font-human);
        font-size: 1.35rem;
        font-weight: 650;
        line-height: 1.1;
    }

    figcaption span {
        font-size: 0.85rem;
        font-variation-settings:
            'wdth' 85,
            'wght' 420;
        line-height: 1.4;
    }

    .description h2 {
        max-width: 21ch;
        margin-bottom: 1.5rem;
        font-family: var(--font-human);
        font-size: clamp(2rem, 3.2vw, 3rem);
        font-weight: 650;
        letter-spacing: -0.025em;
        line-height: 1.05;
        text-wrap: balance;
    }

    .story-copy {
        display: grid;
        gap: 1.25rem;
        max-width: 65ch;
        font-size: clamp(1rem, 1.25vw, 1.2rem);
        font-variation-settings:
            'wdth' 88,
            'wght' 380;
        line-height: 1.6;
    }

    .text-action {
        min-height: var(--touch-target);
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding: 0.75rem 0;
        border-bottom: 1px solid currentColor;
        font-size: 0.95rem;
        font-variation-settings:
            'wdth' 85,
            'wght' 600;
        text-decoration: none;
        transition: color 220ms var(--ease-out);
    }

    .text-action:hover,
    .text-action:focus-visible {
        color: var(--signal);
    }

    .text-action svg {
        flex: none;
        width: 1.25rem;
        height: 1.25rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.5;
    }

    @media (prefers-reduced-motion: no-preference) {
        .text-action svg {
            transition: transform 220ms var(--ease-out);
        }

        .text-action:focus-visible svg {
            transform: translateX(4px);
        }

        .experience-link:focus-visible svg {
            transform: translateY(4px);
        }

        @media (hover: hover) and (pointer: fine) {
            .text-action:hover svg {
                transform: translateX(4px);
            }

            .experience-link:hover svg {
                transform: translateY(4px);
            }
        }
    }

    .experience-link {
        margin-top: 1.5rem;
    }

    .experience-section {
        padding: clamp(3rem, 6vw, 6rem) var(--page-gutter) 0;
    }

    .experience-section > h2 {
        margin-bottom: 2rem;
        font-size: clamp(2.75rem, 5vw, 5rem);
        font-variation-settings:
            'wdth' 74,
            'wght' 380;
        letter-spacing: -0.04em;
        line-height: 1;
    }

    .employment {
        display: grid;
        grid-template-columns: minmax(0, 0.65fr) minmax(0, 1.35fr);
        gap: clamp(2rem, 5vw, 5rem);
        padding: 2rem 0 3rem;
        border-top: 1px solid var(--ink);
        border-bottom: 1px solid var(--ink);
    }

    .employment h3 {
        margin-bottom: 0.75rem;
        font-family: var(--font-human);
        font-size: clamp(2.25rem, 3.5vw, 3.5rem);
        font-weight: 650;
        letter-spacing: -0.025em;
        line-height: 1;
    }

    .role {
        font-size: 1rem;
        font-variation-settings:
            'wdth' 85,
            'wght' 560;
        line-height: 1.5;
    }

    .period {
        font-size: 0.9rem;
        font-variation-settings:
            'wdth' 85,
            'wght' 500;
        font-variant-numeric: tabular-nums;
        line-height: 1.5;
    }

    .employment .period {
        margin-top: 0.5rem;
    }

    .mode {
        margin-top: 1.5rem;
        color: var(--muted);
        font-size: 0.8rem;
        font-variation-settings:
            'wdth' 85,
            'wght' 460;
        line-height: 1.5;
    }

    .premise {
        max-width: 50ch;
        font-size: clamp(1.15rem, 1.55vw, 1.5rem);
        font-variation-settings:
            'wdth' 85,
            'wght' 440;
        line-height: 1.4;
    }

    .contributions {
        display: grid;
        gap: 0.65rem;
        max-width: 70ch;
        margin-top: 1.25rem;
        padding-left: 1.15rem;
        font-size: 1rem;
        font-variation-settings:
            'wdth' 88,
            'wght' 380;
        line-height: 1.6;
    }

    .contributions li {
        padding-left: 0.3rem;
    }

    .contributions li::marker {
        color: var(--heritage-amber-ink);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1rem;
        padding: 0;
        list-style: none;
    }

    .tags li {
        padding: 0.4rem 0.6rem;
        border: 1px solid var(--rule);
        background: var(--heritage-cream);
        font-size: 0.75rem;
        font-variation-settings:
            'wdth' 85,
            'wght' 460;
        line-height: 1.3;
    }

    .assignments > h3 {
        margin: 2.5rem 0 0.5rem;
        font-size: clamp(1.35rem, 2vw, 1.75rem);
        font-variation-settings:
            'wdth' 82,
            'wght' 560;
        line-height: 1.3;
    }

    .timeline {
        padding: 0;
        list-style: none;
    }

    .timeline-entry {
        --timeline-x: 13rem;
        --marker-y: 3.65rem;
        --marker-progress: 1;
        position: relative;
        display: grid;
        grid-template-columns: 11rem minmax(0, 1fr);
        gap: 2rem;
    }

    .assignment-meta {
        padding-top: 3rem;
    }

    .assignment-meta .mode {
        max-width: 18ch;
        margin-top: 0.75rem;
        color: var(--signal);
        font-variation-settings:
            'wdth' 85,
            'wght' 560;
    }

    .range-statement {
        display: block;
        margin-bottom: 0.4rem;
        font-variation-settings:
            'wdth' 88,
            'wght' 580;
    }

    .contact-stamp {
        padding: 1rem 1.25rem;
        background: var(--heritage-cream);
        border: 0;
        box-shadow: 4px 4px 0 var(--ink);
    }

    .contact-stamp:active {
        color: var(--heritage-amber-ink);
    }

    @media (prefers-reduced-motion: no-preference) {
        .contact-stamp {
            transition:
                color 120ms var(--ease-out),
                transform 120ms var(--ease-out),
                box-shadow 120ms var(--ease-out);
        }

        .contact-stamp:active {
            transform: translate(3px, 3px);
            box-shadow: 1px 1px 0 var(--ink);
        }
    }

    .assignment {
        position: relative;
        padding: 3rem 0 3rem 2rem;
    }

    .timeline-track {
        position: absolute;
        top: var(--marker-y);
        bottom: calc(-1 * var(--marker-y));
        left: var(--timeline-x);
        width: 1px;
        background: var(--rule);
        pointer-events: none;
    }

    .timeline-entry:last-child .timeline-track {
        display: none;
    }

    .timeline-trace {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        width: 1px;
        background: var(--signal);
        transform: scaleY(1);
        transform-origin: top;
        pointer-events: none;
    }

    .timeline-marker {
        position: absolute;
        z-index: 1;
        top: var(--marker-y);
        left: calc(var(--timeline-x) + 0.5px);
        width: 0.5rem;
        height: 0.5rem;
        border-radius: calc(var(--marker-progress) * 50%);
        background: color-mix(
            in srgb,
            var(--signal) calc(var(--marker-progress) * 100%),
            var(--heritage-amber-ink)
        );
        transform: translate(-50%, -50%)
            scale(calc(1 + var(--marker-progress) * 1.5));
        pointer-events: none;
    }

    .timeline-entry + .timeline-entry .assignment {
        border-top: 1px solid var(--rule);
    }

    .assignment h4 {
        max-width: 30ch;
        font-family: var(--font-human);
        font-size: clamp(2rem, 3.1vw, 3rem);
        font-weight: 650;
        letter-spacing: -0.025em;
        line-height: 1.05;
        text-wrap: balance;
    }

    .assignment .role {
        margin-top: 0.6rem;
    }

    .assignment .premise {
        margin-top: 1.5rem;
    }

    .about-cta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem 3rem;
        padding: clamp(2rem, 4vw, 4rem) var(--page-gutter);
        border-top: 1px solid var(--ink);
        background: var(--heritage-amber);
    }

    .about-cta > p {
        max-width: 28ch;
        font-family: var(--font-human);
        font-size: clamp(1.5rem, 2.5vw, 2.5rem);
        font-weight: 600;
        line-height: 1.15;
    }

    @media (max-width: 760px) {
        .about [id] {
            scroll-margin-top: 2rem;
        }

        .about-intro,
        .employment {
            grid-template-columns: minmax(0, 1fr);
        }

        h1 em {
            display: inline;
        }

        .portrait {
            margin-top: 1.5rem;
        }

        .timeline-entry {
            --timeline-x: 0rem;
            --marker-y: 2.65rem;
            grid-template-columns: minmax(0, 1fr);
            gap: 0.75rem;
            padding: 2rem 0 2rem 1.25rem;
        }

        .timeline-entry + .timeline-entry {
            border-top: 1px solid var(--rule);
        }

        .assignment-meta {
            padding: 0;
        }

        .assignment-meta .mode {
            max-width: none;
            margin-top: 0.25rem;
        }

        .assignment {
            position: static;
