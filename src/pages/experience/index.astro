---
import Layout from '../../layouts/Layout.astro'

const projects = [
    {
        index: '01',
        period: '2021 — Present',
        role: 'Software Engineer / Full Stack',
        project: 'Defijn',
        mode: 'Agency delivery',
        premise:
            'Ship useful software while improving the system that ships it.',
        points: [
            'Delivered SaaS work for multiple clients from ideation through implementation.',
            'Balanced TypeScript feature delivery, production support, and fast-moving client requests.',
            'Reviewed pull requests, strengthened security and reliability, and surfaced engineering friction.',
        ],
        tags: ['TypeScript', 'Client delivery', 'Code quality'],
    },
    {
        index: '02',
        period: 'Jul 2021 — Jun 2025',
        role: 'Frontend Developer',
        project: 'Investment research platform',
        mode: 'Data + realtime',
        premise: 'Make complex, fast-moving information useful at a glance.',
        points: [
            'Built React and TypeScript product surfaces for aggregated financial data and news.',
            'Implemented REST integrations and realtime WebSocket notifications.',
            'Translated complex data into clear UI and iterated directly from stakeholder feedback.',
        ],
        tags: ['React', 'REST', 'WebSockets'],
    },
    {
        index: '03',
        period: 'Jun 2025 — Dec 2025',
        role: 'QA Engineer',
        project: 'Automation and reliability',
        mode: 'Quality systems',
        premise:
            'Turn release confidence into something the whole team can see.',
        points: [
            'Combined manual regression coverage with automated Playwright journeys.',
            'Integrated tests, videos, and failure artifacts into GitHub Actions.',
            'Added Sentry, uptime alerts, service-health reporting, and email-delivery monitoring.',
        ],
        tags: ['Playwright', 'CI/CD', 'Sentry'],
    },
    {
        index: '04',
        period: 'Aug 2025 — Nov 2025',
        role: 'Frontend Developer',
        project: 'Carbon credit visualisation',
        mode: 'Data interface',
        premise: 'Give a difficult dataset an immediately readable shape.',
        points: [
            'Developed a bespoke bubble graph for UK carbon-credit issuance.',
            'Created sorting and categorisation logic to improve comparison.',
            'Built contextual detail views for each issuing entity.',
        ],
        tags: ['Data visualisation', 'Interaction', 'UI'],
    },
    {
        index: '05',
        period: 'Nov 2025 — Jan 2026',
        role: 'Full Stack Developer',
        project: 'Invoice matching system',
        mode: 'Operational workflow',
        premise: 'Make high-density finance work feel controlled, not crowded.',
        points: [
            'Built and refined invoice-matching views for dense tabular data.',
            'Worked across frontend and backend to preserve accuracy and responsive behavior.',
            'Improved client workflows through interface and performance optimisation.',
        ],
        tags: ['Full stack', 'Dense data', 'Performance'],
    },
    {
        index: '06',
        period: 'Feb 2026 — Present',
        role: 'Full Stack Developer',
        project: 'Property appraisal platform',
        mode: 'Integration reliability',
        premise: 'Strengthen the connections behind a long-running workflow.',
        points: [
            'Took ownership of backend-focused enhancements and workflow stability.',
            'Implemented request flows and synchronisation to a low-code database for document export.',
            'Connected embedded intake forms, backend services, and templated generation processes.',
        ],
        tags: ['Backend', 'Integrations', 'Workflow'],
    },
]
---

<Layout title="Experience | Daniel Vieira Teixeira">
    <main class="experience">
        <header class="page-hero">
            <p class="page-meta">E / 01—06 · Updated Sep 2026</p>
            <h1>Problems solved<br /><em>across the stack.</em></h1>
            <p>
                Six assignments. Four operating modes. One bias toward making
                complex systems more useful and reliable.
            </p>
        </header>

        <nav class="mode-index" aria-label="Experience modes">
            <a href="#project-02"><span>01</span> Frontend</a>
            <a href="#project-06"><span>02</span> Backend</a>
            <a href="#project-03"><span>03</span> QA</a>
            <a href="#project-03"><span>04</span> Reliability</a>
        </nav>

        <section class="project-index" aria-label="Professional experience">
            {
                projects.map(item => (
                    <article id={`project-${item.index}`} class="project-row">
                        <div class="project-meta">
                            <p class="project-number">{item.index}</p>
                            <p>{item.period}</p>
                            <p>{item.role}</p>
                        </div>
                        <div class="project-title">
                            <p>{item.mode}</p>
                            <h2>{item.project}</h2>
                            <p class="premise">{item.premise}</p>
                        </div>
                        <div class="project-detail">
                            <ul>
                                {item.points.map(point => (
                                    <li>{point}</li>
                                ))}
                            </ul>
                            <ul class="tags">
                                {item.tags.map(tag => (
                                    <li>{tag}</li>
                                ))}
                            </ul>
                        </div>
                    </article>
                ))
            }
        </section>

        <footer class="page-cta">
            <p>Need someone who can move between layers?</p>
            <a href="/contact"
                >Bring me the problem <span aria-hidden="true">→</span></a
            >
        </footer>
    </main>
</Layout>

<style lang="scss">
    .experience {
        background: var(--paper);
    }
    .page-meta {
        font-size: 0.7rem;
        font-variation-settings:
            'wdth' 76,
            'wght' 650;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }
    .page-hero {
        position: relative;
        min-height: 72svh;
        display: grid;
        grid-template-columns: 1fr 0.45fr;
        gap: 3rem;
        align-content: space-between;
        padding: var(--page-gutter);
        border-bottom: 1px solid var(--ink);
    }
    .page-meta {
        position: absolute;
        top: var(--page-gutter);
        left: var(--page-gutter);
    }
    .page-hero h1 {
        grid-column: 1 / -1;
        margin-top: clamp(5rem, 10vh, 8rem);
        font-size: clamp(5rem, 9.7vw, 11rem);
        font-variation-settings:
            'wdth' 74,
            'wght' 330;
        letter-spacing: -0.055em;
        line-height: 0.79;
    }
    .page-hero h1 em {
        color: var(--signal);
        font-weight: 780;
    }
    .page-hero > p:last-child {
        grid-column: 2;
        max-width: 34ch;
        font-size: clamp(1.15rem, 1.65vw, 1.65rem);
        font-variation-settings:
            'wdth' 82,
            'wght' 370;
        line-height: 1.35;
    }
    .mode-index {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        padding: 0 var(--page-gutter);
        border-bottom: 1px solid var(--ink);
    }
    .mode-index a {
        display: flex;
        gap: 1rem;
        justify-content: space-between;
        padding: 1.4rem 0;
        color: var(--ink);
        border-right: 1px solid var(--rule);
        font-size: 0.72rem;
        font-variation-settings:
            'wdth' 76,
            'wght' 620;
        letter-spacing: 0.13em;
        text-decoration: none;
        text-transform: uppercase;
    }
    .mode-index a + a {
        padding-left: 1.4rem;
    }
    .mode-index a:last-child {
        border-right: 0;
    }
    .mode-index span {
        color: var(--signal);
    }
    .project-index {
        padding: 0 var(--page-gutter);
    }
    .project-row {
        position: relative;
        display: grid;
        grid-template-columns: minmax(11rem, 0.46fr) minmax(22rem, 1fr) minmax(
                22rem,
                0.82fr
            );
        gap: clamp(1.5rem, 4vw, 5rem);
        min-height: 38rem;
        padding: clamp(3rem, 6vw, 6.5rem) 0;
        border-bottom: 1px solid var(--ink);
    }
    .project-row::before {
        position: absolute;
        top: -1px;
        left: 0;
        width: 100%;
        height: 4px;
        content: '';
        background: var(--signal);
        transform: scaleX(0.045);
        transform-origin: left;
        transition: transform 650ms var(--ease-out);
    }
    .project-row:hover::before {
        transform: scaleX(1);
    }
    .project-meta {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
        font-size: 0.67rem;
        font-variation-settings:
            'wdth' 78,
            'wght' 500;
        letter-spacing: 0.13em;
        line-height: 1.35;
        text-transform: uppercase;
    }
    .project-number {
        margin-bottom: auto;
        color: var(--signal);
        font-size: 1rem;
    }
    .project-title > p:first-child {
        margin-bottom: 2rem;
        color: var(--muted);
        font-size: 0.68rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
    }
    .project-title h2 {
        max-width: 11ch;
        font-size: clamp(3rem, 5.5vw, 6.5rem);
        font-variation-settings:
            'wdth' 73,
            'wght' 500;
        letter-spacing: -0.045em;
        line-height: 0.86;
    }
    .premise {
        max-width: 26ch;
        margin-top: 3rem;
        font-size: clamp(1.15rem, 1.55vw, 1.55rem);
        font-variation-settings:
            'wdth' 82,
            'wght' 380;
        line-height: 1.35;
    }
    .project-detail {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 3rem;
    }
    .project-detail > ul:first-child {
        display: grid;
        gap: 1.2rem;
        padding: 0;
        list-style: none;
    }
    .project-detail > ul:first-child li {
        padding-left: 1.2rem;
        border-left: 1px solid var(--rule);
        font-size: clamp(0.95rem, 1.15vw, 1.15rem);
        font-variation-settings:
            'wdth' 84,
            'wght' 360;
        line-height: 1.45;
    }
    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 0;
        list-style: none;
    }
    .tags li {
        padding: 0.45rem 0.65rem 0.35rem;
        border: 1px solid var(--rule);
        font-size: 0.62rem;
        font-variation-settings:
            'wdth' 76,
            'wght' 600;
        letter-spacing: 0.11em;
        text-transform: uppercase;
    }
    .page-cta {
        display: grid;
        grid-template-columns: 0.55fr 1fr;
        gap: 2rem;
        align-items: end;
        padding: clamp(4rem, 8vw, 8rem) var(--page-gutter);
        color: var(--paper);
        background: var(--ink);
    }
    .page-cta p {
        color: #aaa9a5;
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }
    .page-cta a {
        min-height: var(--touch-target);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 0.8rem;
        color: var(--signal);
        border-bottom: 3px solid currentcolor;
        font-size: clamp(1rem, 1.5vw, 1.5rem);
        font-variation-settings:
            'wdth' 80,
            'wght' 680;
        text-decoration: none;
        text-transform: uppercase;
    }
    @media (max-width: 1100px) {
        .project-row {
            grid-template-columns: 0.35fr 1fr;
        }
        .project-detail {
            grid-column: 2;
        }
    }
    @media (max-width: 760px) {
        .page-hero {
            min-height: 58svh;
        }

        .page-hero h1 {
            margin-top: 3rem;
        }

        .page-hero {
            min-height: 62svh;
            grid-template-columns: 1fr;
        }
        .page-hero h1 {
            grid-column: 1;
            font-size: clamp(4.2rem, 18vw, 7rem);
        }
        .page-hero > p:last-child {
            grid-column: 1;
        }
        .mode-index {
            grid-template-columns: repeat(2, 1fr);
        }
        .mode-index a:nth-child(2) {
            border-right: 0;
        }
        .project-row {
            grid-template-columns: 1fr;
            min-height: 0;
        }
        .project-meta {
            display: grid;
            grid-template-columns: auto 1fr;
        }
        .project-number {
            grid-row: 1 / 3;
            margin-right: 1rem;
        }
        .project-detail {
            grid-column: 1;
        }
        .page-cta {
            grid-template-columns: 1fr;
        }
    }

    /* Project rows stay editorial; warm paper and serif titles carry the archive memory. */
    .page-hero h1 {
        letter-spacing: -0.04em;
    }

    .page-hero h1 em {
        color: var(--heritage-amber-ink);
        font-family: var(--font-human);
        font-weight: 680;
        letter-spacing: -0.02em;
    }

    .project-row {
        transition: background-color 320ms var(--ease-out);
    }

    .project-row:hover {
        background: var(--heritage-cream);
    }
    .project-row::before {
        background: var(--heritage-amber);
    }

    .project-title h2 {
        font-family: var(--font-human);
        font-weight: 670;
        font-variation-settings:
            'opsz' 64,
            'wght' 670;
        letter-spacing: -0.025em;
    }

    .tags li {
        background: var(--heritage-cream);
    }

    .page-cta {
        color: var(--heritage-cream);
        background-color: var(--heritage-charcoal);
        background-image: var(--heritage-texture);
        background-position: center;
        background-size: cover;
        background-blend-mode: soft-light;
    }

    .page-cta a {
        color: var(--heritage-amber);
    }
</style>
