---
import Layout from '../layouts/Layout.astro'
import profileImage from '../assets/profiled.jpg'
---

<Layout title="Daniel Vieira Teixeira">
    <main class="home-hero">
        <img
            class="profile-image"
            src={profileImage.src}
            alt="Portrait of Daniel Vieira Teixeira"
            loading="eager"
            decoding="async"
        />
        <h1>Daniel Vieira Teixeira</h1>
        <hr class="hero-divider" />
        <p>
            Full Stack Software Engineer with strong TypeScript expertise and
            5+ years of experience across frontend, backend, and QA.
        </p>
    </main>
</Layout>

<style lang="scss">
    .home-hero {
        min-height: calc(100dvh - 8rem);
        align-content: center;
        justify-items: center;
        text-align: center;
        gap: 1rem;
        padding-block: 4rem;
    }

    .home-hero h1 {
        font-size: clamp(2rem, 2vw + 1.2rem, 3.2rem);
        line-height: 1.2;
    }

    .profile-image {
        width: clamp(160px, 22vw, 280px);
        aspect-ratio: 1;
        object-fit: cover;
        border-radius: 50%;
        border: 3px solid rgb(255 255 255 / 75%);
        box-shadow: 0 12px 30px rgb(0 0 0 / 35%);
    }

    .hero-divider {
        width: min(100%, 24rem);
        border: 0;
        border-top: 4px solid var(--color-gray-0);
        opacity: 0.95;
        margin-block: 0.25rem;
    }

    .home-hero p {
        max-width: 46ch;
        color: var(--color-gray-0);
        font-size: clamp(1.05rem, 0.4vw + 1rem, 1.4rem);
        line-height: 1.45;
        text-wrap: balance;
    }
</style>
