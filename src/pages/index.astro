---
import Layout from '../layouts/Layout.astro'

import RoleLoom from '../components/RoleLoom.astro'
import HeroPaper from '../components/HeroPaper.astro'
import HeroModes from '../components/HeroModes.astro'
---

<Layout
    title="Daniel Vieira Teixeira | Full-Stack Software Engineer"
    description="Daniel Vieira Teixeira is a full-stack software engineer in Cape Town, building frontend and backend systems with a focus on quality and reliability."
>
    <main class="home" data-mode="frontend">
        <section class="hero" aria-labelledby="hero-title">
            <HeroPaper />
            <RoleLoom />

            <div class="hero-masthead">
                <span
                    class="masthead-frame"
                    style={`--plate: url(/images/portrait-head.webp)`}
                >
                    <img
                        src="/images/portrait-head.webp"
                        alt="Portrait of Daniel Vieira Teixeira"
                        width="160"
                        height="160"
                        loading="eager"
                        decoding="async"
                    />
                </span>
                <p>
                    <strong>Daniel Vieira Teixeira</strong>
                    <span>Full Stack Software Engineer</span>
                </p>
            </div>

            <HeroModes />

            <div class="hero-footer">
                <p class="offer-copy">
                    I solve across the stack<br />to find the right
                    intervention.
                </p>

                <a class="start-project" href="/contact">
                    <span>Start a project</span>
                    <svg viewBox="0 0 32 16" aria-hidden="true"
                        ><path d="M0 8h28M21 1l7 7-7 7"></path></svg
                    >
                </a>
            </div>
        </section>

        <section class="thinking" aria-labelledby="thinking-title">
            <div class="thinking-heading">
                <h2 id="thinking-title">
                    One approach.<br /><span>Variable depth.</span>
                </h2>
            </div>
            <ol>
                <li>
                    <span>01</span><div>
                        <h3>Find the real problem</h3>
                        <p>
                            <strong
                                >Investment research / Frontend + realtime</strong
                            >
                            Unified scattered financial data into one legible decision
                            surface.
                        </p>
                    </div>
                </li>
                <li>
                    <span>02</span><div>
                        <h3>Map the constraint</h3>
                        <p>
                            <strong
                                >Release reliability / QA + observability</strong
                            >
                            Connected tests, CI, monitoring, and Sentry into one release
                            loop.
                        </p>
                    </div>
                </li>
                <li>
                    <span>03</span><div>
                        <h3>Choose the intervention</h3>
                        <p>
                            <strong>Invoice matching / Full stack</strong>
                            Simplified a dense workflow across interface, data, and
                            backend.
                        </p>
                    </div>
                </li>
                <li>
                    <span>04</span><div>
                        <h3>Leave a stronger system</h3>
                        <p>
                            <strong>Property appraisal / Integration</strong>
                            Stabilised the hand-offs behind a long-running client
                            workflow.
                        </p>
                    </div>
                </li>
            </ol>
            <div class="thinking-actions">
                <a class="thinking-link" href="/about#experience">
                    <span>View experience</span>
                    <span aria-hidden="true">↗</span>
                </a>
                <a class="thinking-cta" href="/contact">
                    <span>Start a conversation</span>
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </section>
    </main>
</Layout>

<script>
    import { gsap } from 'gsap'

    let disposeMotion: (() => void) | undefined
    let heroRevealed = false

    function initHomepageMotion(): void {
        disposeMotion?.()
        const root = document.querySelector<HTMLElement>('.home')
        if (!root) return

        const media = gsap.matchMedia()
        const context = gsap.context(() => {
            media.add(
                '(prefers-reduced-motion: no-preference)',
                () => {
                    const statement =
                        root.querySelector<HTMLElement>('.statement')
                    // Returning visitors and restored scroll positions skip the entrance.
                    if (!heroRevealed && statement) {
                        heroRevealed = true
                        const bounds = statement.getBoundingClientRect()
                        if (
                            bounds.top >= 0 &&
                            bounds.top < window.innerHeight
                        ) {
                            gsap.fromTo(
                                '.statement-word',
                                { clipPath: 'inset(-80% 100% -80% -8%)' },
                                {
                                    clipPath: 'inset(-80% -8% -80% -8%)',
                                    duration: 0.56,
                                    stagger: 0.07,
                                    ease: 'expo.out',
                                    clearProps: 'clipPath',
                                },
                            )
                        }
                    }
                },
                root,
            )

            media.add(
                '(prefers-reduced-motion: reduce)',
                () => {
                    heroRevealed = true
                },
                root,
            )
        }, root)
        disposeMotion = () => {
            media.revert()
            context.revert()
            disposeMotion = undefined
        }
    }

    function cleanupHomepageMotion(): void {
        disposeMotion?.()
    }

    document.addEventListener('astro:page-load', initHomepageMotion)
    document.addEventListener('astro:before-swap', cleanupHomepageMotion)

    if (import.meta.hot) {
        import.meta.hot.dispose(() => {
            cleanupHomepageMotion()
            document.removeEventListener('astro:page-load', initHomepageMotion)
            document.removeEventListener(
                'astro:before-swap',
                cleanupHomepageMotion,
            )
        })
    }
</script>

<style lang="scss">
    .home {
        background: transparent;
    }

    .hero {
        position: relative;
        isolation: isolate;
        background: transparent;
        overflow: clip;
        box-sizing: border-box;
        min-height: 100vh;
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-content: space-between;
        gap: 2rem;
        padding: 1rem var(--page-gutter) 2rem;
    }

    .hero > * {
        min-width: 0;
    }

    .hero-footer {
        position: relative;
        z-index: 3;
    }

    .hero-footer {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.5rem 2rem;
    }
    .offer-copy {
        font-size: 1.1rem;
        font-variation-settings:
            'wdth' 74,
            'wght' 390;
        line-height: 1.35;
    }
    .start-project {
        display: flex;
        flex: 1 0 100%;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: var(--touch-target);
        padding-bottom: 0.55rem;
        color: var(--signal);
        border-bottom: 2px solid currentcolor;
        font-size: 0.85rem;
        font-variation-settings:
            'wdth' 82,
            'wght' 650;
        letter-spacing: 0.13em;
        text-decoration: none;
        text-transform: uppercase;
        transition: color 220ms var(--ease-out);

        svg {
            flex: 0 0 1.7rem;
            width: 1.7rem;
            fill: none;
            stroke: currentcolor;
            stroke-linecap: square;
            stroke-width: 1.5;
        }
        &:hover {
            color: var(--ink);
        }
    }

    /* Tablet: give the specimen the full width. */
    @media (min-width: 761px) {
        .hero {
            gap: 2.5rem;
            padding-block: 1.5rem 2.5rem;
        }
        .start-project {
            flex: 0 0 12rem;
            margin-left: auto;
        }
    }

    /* Desktop: preserve the specimen width alongside the open graphic area. */
    @media (min-width: 1201px) {
        .hero {
            min-height: 100svh;
            gap: clamp(0.75rem, 2svh, 1.5rem);
            padding-block: 1rem;
        }
        .offer-copy {
            margin-left: auto;
        }
        .start-project {
            margin-left: 0;
        }
    }

    .thinking {
        display: grid;
        grid-template-columns: minmax(24rem, 0.88fr) 1fr;
        gap: 0px clamp(4rem, 9vw, 10rem);
        padding: clamp(5rem, 10vw, 10rem) var(--page-gutter);
        color: var(--paper);
        border-top: 1px solid var(--ink);
        background: var(--ink);
    }

    .thinking-heading {
        position: sticky;
        top: 2rem;
        align-self: start;
    }

    .thinking h2 {
        font-size: clamp(3.8rem, 7.2vw, 8.4rem);
        font-variation-settings:
            'wdth' 74,
            'wght' 320;
        letter-spacing: -0.04em;
        line-height: 0.82;
    }

    .thinking h2 span {
        color: var(--signal-dark);
        font-style: italic;
        font-weight: 760;
    }

    .thinking ol {
        list-style: none;
    }

    .thinking li {
        display: grid;
        grid-template-columns: 3rem 1fr;
        gap: clamp(1.25rem, 3vw, 3rem);
        padding: 2rem 0 4rem;
        border-top: 1px solid var(--rule-on-dark);
    }

    .thinking li > span {
        color: var(--signal-dark);
        font-size: 0.7rem;
        letter-spacing: 0.15em;
    }

    .thinking li h3 {
        margin-bottom: 1rem;
        font-size: clamp(1.7rem, 2.7vw, 3rem);
        font-variation-settings:
            'wdth' 82,
            'wght' 560;
        line-height: 1;
    }

    .thinking li p {
        max-width: 42ch;
        color: var(--copy-on-dark);
        font-size: clamp(1rem, 1.25vw, 1.25rem);
        font-variation-settings:
            'wdth' 84,
            'wght' 350;
        line-height: 1.5;
    }

    .thinking li strong {
        display: block;
        margin-bottom: 0.65rem;
        color: var(--signal-dark);
        font-family: var(--font-body);
        font-size: 0.68rem;
        font-variation-settings:
            'wdth' 78,
            'wght' 650;
        letter-spacing: 0.13em;
        line-height: 1.35;
        text-transform: uppercase;
    }

    .thinking-actions {
        grid-column: 2;
        display: grid;
        gap: 1.5rem;
    }

    .thinking-link,
    .thinking-cta {
        min-height: var(--touch-target);
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: min(38rem, 100%);
        margin-left: auto;
        font-variation-settings:
            'wdth' 80,
            'wght' 680;
        letter-spacing: 0.12em;
        text-decoration: none;
        text-transform: uppercase;
    }

    .thinking-link {
        padding-bottom: 0.75rem;
        color: var(--paper-soft);
        border-bottom: 1px solid currentcolor;
        font-size: 0.76rem;
        transition: color 220ms var(--ease-out);
    }

    .thinking-link:hover {
        color: var(--signal-dark);
    }

    .thinking-cta {
        padding: 1rem 1.1rem 0.85rem;
        color: var(--paper-soft);
        border: 0;
        background: var(--signal);
        box-shadow: 4px 4px 0 var(--paper-soft);
        font-size: clamp(0.85rem, 1.15vw, 1.15rem);
        transition:
            transform 220ms var(--ease-out),
            box-shadow 220ms var(--ease-out);
    }

    .thinking-cta:hover {
        transform: translate(-2px, -2px);
        box-shadow: 6px 6px 0 var(--paper-soft);
    }

    .thinking-link:focus-visible,
    .thinking-cta:focus-visible {
        outline: 2px solid var(--signal-dark);
        outline-offset: 5px;
    }

    @media (max-width: 1100px) {
        .thinking {
            grid-template-columns: 1fr;
        }

        .thinking-heading {
            position: static;
        }

        .thinking-actions {
            grid-column: 1;
        }
    }

    @media (max-width: 640px) {
        .thinking {
            column-gap: 4rem;
            padding-block: 4.5rem;
        }

        .thinking h2 {
            font-size: clamp(3.35rem, 16vw, 5.25rem);
        }

        .thinking li {
            grid-template-columns: 2rem 1fr;
            padding-bottom: 3rem;
        }

        .thinking-actions {
            gap: 1.25rem;
        }
    }

    .thinking {
        background-color: var(--charcoal);
        background-image: var(--ink-grain);
        background-position: center;
        background-size: 256px;
    }

    .thinking li h3 {
        font-family: var(--font-human);
        font-weight: 650;
    }

    .hero-masthead {
        display: none;
    }

    .masthead-frame {
        position: relative;
        display: block;
        flex: none;
        width: 3.5rem;
        height: 3.5rem;
    }

    .masthead-frame::before {
        position: absolute;
        inset: 0;
        content: '';
        background: var(--signal);
        -webkit-mask-image: var(--plate);
        mask-image: var(--plate);
        -webkit-mask-size: 100% 100%;
        mask-size: 100% 100%;
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        transform: translate(4px, 0);
    }

    .masthead-frame img {
        position: relative;
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Phones get a printed masthead instead of a footer plate under the dock. */
    @media (max-width: 760px) {
        .hero {
            padding-bottom: 2rem;
        }

        .hero-masthead {
            position: relative;
            z-index: 3;
            display: flex;
            align-items: center;
            gap: 0.9rem;
        }

        .hero-masthead p {
            display: grid;
            gap: 0.2rem;
        }

        .hero-masthead strong {
            font-family: var(--font-human);
            font-size: 1rem;
            font-weight: 650;
            line-height: 1.1;
        }

        .hero-masthead p span {
            color: var(--muted);
            font-size: 0.62rem;
            font-variation-settings:
                'wdth' 80,
                'wght' 600;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }
    }
</style>
