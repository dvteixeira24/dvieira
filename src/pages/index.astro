---
import Layout from '../layouts/Layout.astro'
import profileImage from '../assets/profiled.jpg'
import RoleLoom from '../components/RoleLoom.astro'
import HeroPaper from '../components/HeroPaper.astro'
import HeroModes from '../components/HeroModes.astro'
---

<Layout
    title="Daniel Vieira Teixeira | Full-Stack Software Engineer"
    description="Daniel Vieira Teixeira is a full-stack software engineer in Cape Town, building frontend and backend systems with a focus on quality and reliability."
>
    <main class="home" data-mode="frontend">
        <section class="hero" aria-labelledby="hero-title">
            <HeroPaper />
            <RoleLoom />
            <HeroModes />

            <div class="hero-footer">
                <figure class="portrait-seal">
                    <img
                        src={profileImage.src}
                        alt="Portrait of Daniel Vieira Teixeira"
                        loading="eager"
                        decoding="async"
                    />
                    <figcaption>
                        <strong>Daniel Vieira Teixeira</strong><span
                            >Full Stack Software Engineer</span
                        >
                    </figcaption>
                </figure>

                <p class="coordinates" aria-label="Cape Town coordinates">
                    33.9249° S<br />18.4241° E
                </p>
                <p class="process-mantra">
                    Engineer<br />Build<br />Improve<br />Repeat
                </p>
                <p class="offer-copy">
                    I solve across the stack<br />to find the right
                    intervention.
                </p>

                <a class="start-project" href="/contact">
                    <span>Start a project</span>
                    <svg viewBox="0 0 32 16" aria-hidden="true"
                        ><path d="M0 8h28M21 1l7 7-7 7"></path></svg
                    >
                </a>
            </div>
        </section>

        <section class="thinking" aria-labelledby="thinking-title">
            <div class="thinking-heading">
                <h2 id="thinking-title">
                    One approach.<br /><span>Variable depth.</span>
                </h2>
            </div>
            <ol>
                <li>
                    <span>01</span><div>
                        <h3>Find the real problem</h3>
                        <p>
                            <strong
                                >Investment research / Frontend + realtime</strong
                            >
                            Unified scattered financial data into one legible decision
                            surface.
                        </p>
                    </div>
                </li>
                <li>
                    <span>02</span><div>
                        <h3>Map the constraint</h3>
                        <p>
                            <strong
                                >Release reliability / QA + observability</strong
                            >
                            Connected tests, CI, monitoring, and Sentry into one release
                            loop.
                        </p>
                    </div>
                </li>
                <li>
                    <span>03</span><div>
                        <h3>Choose the intervention</h3>
                        <p>
                            <strong>Invoice matching / Full stack</strong>
                            Simplified a dense workflow across interface, data, and
                            backend.
                        </p>
                    </div>
                </li>
                <li>
                    <span>04</span><div>
                        <h3>Leave a stronger system</h3>
                        <p>
                            <strong>Property appraisal / Integration</strong>
                            Stabilised the hand-offs behind a long-running client
                            workflow.
                        </p>
                    </div>
                </li>
            </ol>
            <div class="thinking-actions">
                <a class="thinking-link" href="/about#experience">
                    <span>View experience</span>
                    <span aria-hidden="true">↗</span>
                </a>
                <a class="thinking-cta" href="/contact">
                    <span>Start a conversation</span>
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </section>
    </main>
</Layout>

<script>
    import { gsap } from 'gsap'

    let disposeMotion: (() => void) | undefined
    let heroRevealed = false

    function initHomepageMotion(): void {
        disposeMotion?.()
        const root = document.querySelector<HTMLElement>('.home')
        if (!root) return

        const media = gsap.matchMedia()
        const context = gsap.context(() => {
            media.add(
                '(prefers-reduced-motion: no-preference)',
                () => {
                    const statement =
                        root.querySelector<HTMLElement>('.statement')
                    // Returning visitors and restored scroll positions skip the entrance.
                    if (!heroRevealed && statement) {
                        heroRevealed = true
                        const bounds = statement.getBoundingClientRect()
                        if (
                            bounds.top >= 0 &&
                            bounds.top < window.innerHeight
                        ) {
                            gsap.fromTo(
                                '.statement-word',
                                { clipPath: 'inset(-80% 100% -80% -8%)' },
                                {
                                    clipPath: 'inset(-80% -8% -80% -8%)',
                                    duration: 0.56,
                                    stagger: 0.07,
                                    ease: 'expo.out',
                                    clearProps: 'clipPath',
                                },
                            )
                        }
                    }
                },
                root,
            )

            media.add(
                '(prefers-reduced-motion: reduce)',
                () => {
                    heroRevealed = true
                },
                root,
            )

            media.add(
                '(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)',
                () => {
                    const seal =
                        root.querySelector<HTMLElement>('.portrait-seal')
                    const portrait = seal?.querySelector('img')
                    if (!seal || !portrait) return

                    gsap.set(portrait, { transformPerspective: 600 })
                    const options = { duration: 0.35, ease: 'power3.out' }
                    const tiltX = gsap.quickTo(portrait, 'rotationX', options)
                    const tiltY = gsap.quickTo(portrait, 'rotationY', options)
                    const moveX = gsap.quickTo(portrait, 'x', options)
                    const moveY = gsap.quickTo(portrait, 'y', options)
                    const clamp = gsap.utils.clamp(-1, 1)
                    let bounds: DOMRect | undefined

                    const reset = (): void => {
                        bounds = undefined
                        tiltX(0)
                        tiltY(0)
                        moveX(0)
                        moveY(0)
                    }
                    const enter = (): void => {
                        bounds = seal.getBoundingClientRect()
                    }
                    const move = (event: PointerEvent): void => {
                        if (event.pointerType !== 'mouse') return
                        bounds ??= seal.getBoundingClientRect()
                        const x = clamp(
                            ((event.clientX - bounds.left) / bounds.width) * 2 -
                                1,
                        )
                        const y = clamp(
                            ((event.clientY - bounds.top) / bounds.height) * 2 -
                                1,
                        )
                        tiltX(-y * 5)
                        tiltY(x * 5)
                        moveX(x * 2)
                        moveY(y * 2)
                    }
                    const visibility = (): void => {
                        if (document.hidden) reset()
                    }

                    seal.addEventListener('pointerenter', enter)
                    seal.addEventListener('pointermove', move)
                    seal.addEventListener('pointerleave', reset)
                    seal.addEventListener('pointercancel', reset)
                    window.addEventListener('scroll', reset, { passive: true })
                    window.addEventListener('blur', reset)
                    window.addEventListener('resize', reset)
                    document.addEventListener('visibilitychange', visibility)
                    return () => {
                        seal.removeEventListener('pointerenter', enter)
                        seal.removeEventListener('pointermove', move)
                        seal.removeEventListener('pointerleave', reset)
                        seal.removeEventListener('pointercancel', reset)
                        window.removeEventListener('scroll', reset)
                        window.removeEventListener('blur', reset)
                        window.removeEventListener('resize', reset)
                        document.removeEventListener(
                            'visibilitychange',
                            visibility,
                        )
                    }
                },
                root,
            )
        }, root)
        disposeMotion = () => {
            media.revert()
            context.revert()
            disposeMotion = undefined
        }
    }

    function cleanupHomepageMotion(): void {
        disposeMotion?.()
    }

    document.addEventListener('astro:page-load', initHomepageMotion)
    document.addEventListener('astro:before-swap', cleanupHomepageMotion)

    if (import.meta.hot) {
        import.meta.hot.dispose(() => {
            cleanupHomepageMotion()
            document.removeEventListener('astro:page-load', initHomepageMotion)
            document.removeEventListener(
                'astro:before-swap',
                cleanupHomepageMotion,
            )
        })
    }
</script>

<style lang="scss">
    .home {
        background: var(--paper);
    }

    .hero {
        position: relative;
        isolation: isolate;
        background: var(--paper);
        overflow: clip;
        box-sizing: border-box;
        min-height: 100vh;
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-content: space-between;
        gap: 2rem;
        padding: 1rem var(--page-gutter) 2rem;
    }

    .hero > * {
        min-width: 0;
    }

    .hero-footer {
        position: relative;
        z-index: 3;
    }

    .hero-footer {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.5rem 2rem;
    }
    .coordinates,
    .process-mantra {
        display: none;
        font-size: 0.65rem;
        font-variation-settings:
            'wdth' 74,
            'wght' 490;
        letter-spacing: 0.14em;
        line-height: 1.45;
        text-transform: uppercase;
    }
    .coordinates {
        color: var(--muted);
    }
    .offer-copy {
        font-size: 1.1rem;
        font-variation-settings:
            'wdth' 74,
            'wght' 390;
        line-height: 1.35;
    }
    .start-project {
        display: flex;
        flex: 1 0 100%;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: var(--touch-target);
        padding-bottom: 0.55rem;
        color: var(--signal);
        border-bottom: 2px solid currentcolor;
        font-size: 0.85rem;
        font-variation-settings:
            'wdth' 82,
            'wght' 650;
        letter-spacing: 0.13em;
        text-decoration: none;
        text-transform: uppercase;
        transition: color 220ms var(--ease-out);

        svg {
            flex: 0 0 1.7rem;
            width: 1.7rem;
            fill: none;
            stroke: currentcolor;
            stroke-linecap: square;
            stroke-width: 1.5;
        }
        &:hover {
            color: var(--ink);
        }
    }

    /* Tablet: give the specimen the full width. */
    @media (min-width: 761px) {
        .hero {
            gap: 2.5rem;
            padding-block: 1.5rem 2.5rem;
        }
        .start-project {
            flex: 0 0 12rem;
            margin-left: auto;
        }
    }

    /* Desktop: preserve the specimen width alongside the open graphic area. */
    @media (min-width: 1201px) {
        .hero {
            min-height: 100svh;
            gap: clamp(1rem, 2.5svh, 2rem);
            padding-block: 1.25rem 1.5rem;
        }
        .coordinates,
        .process-mantra {
            display: block;
        }
        .offer-copy {
            margin-left: auto;
        }
        .start-project {
            margin-left: 0;
        }
    }

    .thinking {
        display: grid;
        grid-template-columns: minmax(24rem, 0.88fr) 1fr;
        gap: 0px clamp(4rem, 9vw, 10rem);
        padding: clamp(5rem, 10vw, 10rem) var(--page-gutter);
        color: var(--paper);
        border-top: 1px solid var(--ink);
        background: var(--ink);
    }

    .thinking-heading {
        position: sticky;
        top: 2rem;
        align-self: start;
    }

    .thinking h2 {
        font-size: clamp(3.8rem, 7.2vw, 8.4rem);
        font-variation-settings:
            'wdth' 74,
            'wght' 320;
        letter-spacing: -0.04em;
        line-height: 0.82;
    }

    .thinking h2 span {
        color: var(--signal);
        font-style: italic;
        font-weight: 760;
    }

    .thinking ol {
        list-style: none;
    }

    .thinking li {
        display: grid;
        grid-template-columns: 3rem 1fr;
        gap: clamp(1.25rem, 3vw, 3rem);
        padding: 2rem 0 4rem;
        border-top: 1px solid #565655;
    }

    .thinking li > span {
        color: var(--signal);
        font-size: 0.7rem;
        letter-spacing: 0.15em;
    }

    .thinking li h3 {
        margin-bottom: 1rem;
        font-size: clamp(1.7rem, 2.7vw, 3rem);
        font-variation-settings:
            'wdth' 82,
            'wght' 560;
        line-height: 1;
    }

    .thinking li p {
        max-width: 42ch;
        color: #d0cbc3;
        font-size: clamp(1rem, 1.25vw, 1.25rem);
        font-variation-settings:
            'wdth' 84,
            'wght' 350;
        line-height: 1.5;
    }

    .thinking li strong {
        display: block;
        margin-bottom: 0.65rem;
        color: var(--heritage-amber);
        font-family: var(--font-body);
        font-size: 0.68rem;
        font-variation-settings:
            'wdth' 78,
            'wght' 650;
        letter-spacing: 0.13em;
        line-height: 1.35;
        text-transform: uppercase;
    }

    .thinking-actions {
        grid-column: 2;
        display: grid;
        gap: 1.5rem;
    }

    .thinking-link,
    .thinking-cta {
        min-height: var(--touch-target);
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: min(38rem, 100%);
        margin-left: auto;
        font-variation-settings:
            'wdth' 80,
            'wght' 680;
        letter-spacing: 0.12em;
        text-decoration: none;
        text-transform: uppercase;
    }

    .thinking-link {
        padding-bottom: 0.75rem;
        color: var(--heritage-cream);
        border-bottom: 1px solid currentcolor;
        font-size: 0.76rem;
        transition: color 220ms var(--ease-out);
    }

    .thinking-link:hover {
        color: var(--heritage-amber);
    }

    .thinking-cta {
        padding: 1rem 1.1rem 0.85rem;
        color: var(--ink);
        border: 0;
        background: var(--heritage-amber);
        box-shadow: 4px 4px 0 var(--heritage-cream);
        font-size: clamp(0.85rem, 1.15vw, 1.15rem);
        transition:
            transform 220ms var(--ease-out),
            box-shadow 220ms var(--ease-out);
    }

    .thinking-cta:hover {
        transform: translate(-2px, -2px);
        box-shadow: 6px 6px 0 var(--heritage-cream);
    }

    .thinking-link:focus-visible,
    .thinking-cta:focus-visible {
        outline: 2px solid var(--heritage-amber);
        outline-offset: 5px;
    }

    @media (max-width: 1100px) {
        .thinking {
            grid-template-columns: 1fr;
        }

        .thinking-heading {
            position: static;
        }

        .thinking-actions {
            grid-column: 1;
        }
    }

    @media (max-width: 640px) {
        .thinking {
            column-gap: 4rem;
            padding-block: 4.5rem;
        }

        .thinking h2 {
            font-size: clamp(3.35rem, 16vw, 5.25rem);
        }

        .thinking li {
            grid-template-columns: 2rem 1fr;
            padding-bottom: 3rem;
        }

        .thinking-actions {
            gap: 1.25rem;
        }
    }

    /* Heritage layer: personal warmth inside the technical proof sheet. */
    .portrait-seal {
        display: grid;
        grid-template-columns: 4.75rem minmax(0, 1fr);
        gap: 1.25rem;
        align-items: center;
        width: 100%;
        padding: 0.85rem;
        background: var(--heritage-cream);
        box-shadow: 3px 3px 0 var(--heritage-amber);
    }
    .portrait-seal img {
        width: 4.75rem;
        aspect-ratio: 1;
        border: 3px solid var(--heritage-cream);
        border-radius: 50%;
        outline: 1px solid var(--ink);
        object-fit: cover;
        filter: grayscale(1) contrast(1.06);
    }
    .portrait-seal figcaption {
        display: grid;
        gap: 0.25rem;
        font-family: var(--font-human);
    }
    .portrait-seal figcaption strong {
        font-size: 1.15rem;
        line-height: 1.1;
    }
    .portrait-seal figcaption span {
        color: var(--muted);
        font-family: var(--font-body);
        font-size: 0.68rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }
    @media (min-width: 761px) {
        .portrait-seal {
            width: auto;
            max-width: 22rem;
        }
    }
    @media (min-width: 1201px) {
        .portrait-seal {
            display: block;
            padding: 0;
        }
        .portrait-seal figcaption {
            display: none;
        }
    }

    .thinking {
        background-color: var(--heritage-charcoal);
        background-image: var(--heritage-texture);
        background-position: center;
        background-size: cover;
        background-blend-mode: soft-light;
    }

    .thinking li h3 {
        font-family: var(--font-human);
        font-weight: 650;
    }
</style>
