---
import Layout from '../layouts/Layout.astro'
import profileImage from '../assets/profiled.jpg'
import RoleLoom from '../components/RoleLoom.astro'
import HeroPaper from '../components/HeroPaper.astro'
---

<Layout>
    <main class="home" data-mode="frontend">
        <section class="hero" aria-labelledby="hero-title">
            <HeroPaper />
            <RoleLoom />
            <div
                class="mode-sequencer"
                role="group"
                aria-label="Engineering modes"
            >
                <button type="button" data-mode="frontend" aria-pressed="true"
                    ><span>01</span> Frontend</button
                >
                <button type="button" data-mode="backend" aria-pressed="false"
                    ><span>02</span> Backend</button
                >
                <button type="button" data-mode="qa" aria-pressed="false"
                    ><span>03</span> QA</button
                >
                <button
                    type="button"
                    data-mode="reliability"
                    aria-pressed="false"><span>04</span> Reliability</button
                >
            </div>

            <h1
                id="hero-title"
                class="statement"
                aria-label="Different systems. Same approach."
            >
                <span
                    class="statement-line statement-different"
                    aria-hidden="true"
                >
                    <span class="statement-word">Different</span>
                    <span class="width-readout">
                        <span class="readout-line"></span>
                        <b
                            >Wdth <output data-axis-value="different"
                                >102</output
                            ></b
                        >
                    </span>
                </span>
                <span
                    class="statement-line statement-systems"
                    aria-hidden="true"
                >
                    <span class="statement-word">systems.</span>
                    <span class="width-readout">
                        <span class="readout-line"></span>
                        <b
                            >Wdth <output data-axis-value="systems">106</output
                            ></b
                        >
                    </span>
                </span>
                <span class="statement-line statement-same" aria-hidden="true">
                    <span class="statement-word">Same</span>
                    <span class="width-readout">
                        <span class="readout-line"></span>
                        <b>Wdth <output data-axis-value="same">104</output></b>
                    </span>
                </span>
                <span
                    class="statement-line statement-approach"
                    aria-hidden="true"
                >
                    <span class="statement-word">approach.</span>
                    <span class="width-readout">
                        <span class="readout-line"></span>
                        <b
                            >Wdth <output data-axis-value="approach">102</output
                            ></b
                        >
                    </span>
                </span>
            </h1>

            <aside class="reasoning" aria-label="Problem-solving approach">
                <dl>
                    <div>
                        <dt>Problem</dt><dd>
                            Understand what’s actually happening.
                        </dd>
                    </div>
                    <div>
                        <dt>Constraint</dt><dd>Work within real limits.</dd>
                    </div>
                    <div>
                        <dt>Intervention</dt><dd>
                            Design and build the right solution.
                        </dd>
                    </div>
                    <div>
                        <dt>Outcome</dt><dd>
                            A more reliable, scalable system.
                        </dd>
                    </div>
                </dl>
            </aside>

            <div class="hero-footer">
                <figure class="portrait-seal">
                    <img
                        src={profileImage.src}
                        alt="Portrait of Daniel Vieira Teixeira"
                        loading="eager"
                        decoding="async"
                    />
                    <figcaption>
                        <strong>Daniel Vieira Teixeira</strong><span
                            >Full Stack Software Engineer</span
                        >
                    </figcaption>
                </figure>

                <p class="coordinates" aria-label="Cape Town coordinates">
                    33.9249° S<br />18.4241° E
                </p>
                <p class="process-mantra">
                    Engineer<br />Build<br />Improve<br />Repeat
                </p>
                <p class="offer-copy">
                    I solve across the stack<br />to find the right
                    intervention.
                </p>

                <a class="start-project" href="/contact">
                    <span>Start a project</span>
                    <svg viewBox="0 0 32 16" aria-hidden="true"
                        ><path d="M0 8h28M21 1l7 7-7 7"></path></svg
                    >
                </a>
            </div>
        </section>

        <section class="thinking" aria-labelledby="thinking-title">
            <div class="thinking-heading">
                <h2 id="thinking-title">
                    One approach.<br /><span>Variable depth.</span>
                </h2>
            </div>
            <ol>
                <li>
                    <span>01</span><div>
                        <h3>Find the real problem</h3>
                        <p>
                            <strong
                                >Investment research / Frontend + realtime</strong
                            >
                            Unified scattered financial data into one legible decision
                            surface.
                        </p>
                    </div>
                </li>
                <li>
                    <span>02</span><div>
                        <h3>Map the constraint</h3>
                        <p>
                            <strong
                                >Release reliability / QA + observability</strong
                            >
                            Connected tests, CI, monitoring, and Sentry into one release
                            loop.
                        </p>
                    </div>
                </li>
                <li>
                    <span>03</span><div>
                        <h3>Choose the intervention</h3>
                        <p>
                            <strong>Invoice matching / Full stack</strong>
                            Simplified a dense workflow across interface, data, and
                            backend.
                        </p>
                    </div>
                </li>
                <li>
                    <span>04</span><div>
                        <h3>Leave a stronger system</h3>
                        <p>
                            <strong>Property appraisal / Integration</strong>
                            Stabilised the hand-offs behind a long-running client
                            workflow.
                        </p>
                    </div>
                </li>
            </ol>
            <div class="thinking-actions">
                <a class="thinking-link" href="/about#experience">
                    <span>View experience</span>
                    <span aria-hidden="true">↗</span>
                </a>
                <a class="thinking-cta" href="/contact">
                    <span>Start a conversation</span>
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </section>
    </main>
</Layout>

<script is:inline data-astro-rerun>
    ;(() => {
        const root = document.querySelector('[data-mode]')
        if (!root || root.dataset.modeReady === 'true') return

        root.dataset.modeReady = 'true'
        const controls = root.querySelectorAll('.mode-sequencer button')
        const axisValues = {
            frontend: { different: 58, systems: 88, same: 112, approach: 132 },
            backend: { different: 92, systems: 136, same: 72, approach: 102 },
            qa: { different: 102, systems: 106, same: 104, approach: 102 },
            reliability: {
                different: 118,
                systems: 105,
                same: 62,
                approach: 140,
            },
        }
        const showAxisValues = mode => {
            const values = axisValues[mode]
            if (!values) return
            root.querySelectorAll('[data-axis-value]').forEach(output => {
                const axis = output.dataset.axisValue
                if (axis && values[axis] !== undefined)
                    output.value = values[axis]
            })
        }
        const selectMode = control => {
            const mode = control.dataset.mode
            if (!mode) return
            root.dataset.mode = mode
            showAxisValues(mode)
            controls.forEach(button => {
                button.setAttribute('aria-pressed', String(button === control))
            })
        }
        let timer
        let heroVisible = true
        const stopTimer = () => window.clearInterval(timer)
        const restartTimer = () => {
            stopTimer()
            if (document.hidden || !heroVisible) return
            timer = window.setInterval(() => {
                const current = [...controls].findIndex(
                    control => control.dataset.mode === root.dataset.mode,
                )
                selectMode(controls[(current + 1) % controls.length])
            }, 5000)
        }
        const listeners = new AbortController()
        controls.forEach(control => {
            control.addEventListener(
                'click',
                () => {
                    selectMode(control)
                    restartTimer()
                },
                { signal: listeners.signal },
            )
        })
        const observer = new IntersectionObserver(entries => {
            heroVisible = entries[0].isIntersecting
            restartTimer()
        })
        observer.observe(root.querySelector('.hero'))
        document.addEventListener('visibilitychange', restartTimer, {
            signal: listeners.signal,
        })
        document.addEventListener(
            'astro:before-swap',
            () => {
                stopTimer()
                observer.disconnect()
                listeners.abort()
                delete root.dataset.modeReady
            },
            { once: true, signal: listeners.signal },
        )
        showAxisValues(root.dataset.mode)
        restartTimer()
    })()
</script>

<script>
    import { gsap } from 'gsap'

    let disposeMotion: (() => void) | undefined
    let heroRevealed = false

    function initHomepageMotion(): void {
        disposeMotion?.()
        const root = document.querySelector<HTMLElement>('.home')
        if (!root) return

        const media = gsap.matchMedia()
        const context = gsap.context(() => {
            media.add(
                '(prefers-reduced-motion: no-preference)',
                () => {
                    const statement =
                        root.querySelector<HTMLElement>('.statement')
                    // Returning visitors and restored scroll positions skip the entrance.
                    if (!heroRevealed && statement) {
                        heroRevealed = true
                        const bounds = statement.getBoundingClientRect()
                        if (
                            bounds.top >= 0 &&
                            bounds.top < window.innerHeight
                        ) {
                            gsap.fromTo(
                                '.statement-word',
                                { clipPath: 'inset(-80% 100% -80% -8%)' },
                                {
                                    clipPath: 'inset(-80% -8% -80% -8%)',
                                    duration: 0.56,
                                    stagger: 0.07,
                                    ease: 'expo.out',
                                    clearProps: 'clipPath',
                                },
                            )
                        }
                    }
                },
                root,
            )

            media.add(
                '(prefers-reduced-motion: reduce)',
                () => {
                    heroRevealed = true
                },
                root,
            )

            media.add(
                '(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)',
                () => {
                    const seal =
                        root.querySelector<HTMLElement>('.portrait-seal')
                    const portrait = seal?.querySelector('img')
                    if (!seal || !portrait) return

                    gsap.set(portrait, { transformPerspective: 600 })
                    const options = { duration: 0.35, ease: 'power3.out' }
                    const tiltX = gsap.quickTo(portrait, 'rotationX', options)
                    const tiltY = gsap.quickTo(portrait, 'rotationY', options)
                    const moveX = gsap.quickTo(portrait, 'x', options)
                    const moveY = gsap.quickTo(portrait, 'y', options)
                    const clamp = gsap.utils.clamp(-1, 1)
                    let bounds: DOMRect | undefined

                    const reset = (): void => {
                        bounds = undefined
                        tiltX(0)
                        tiltY(0)
                        moveX(0)
                        moveY(0)
                    }
                    const enter = (): void => {
                        bounds = seal.getBoundingClientRect()
                    }
                    const move = (event: PointerEvent): void => {
                        if (event.pointerType !== 'mouse') return
                        bounds ??= seal.getBoundingClientRect()
                        const x = clamp(
                            ((event.clientX - bounds.left) / bounds.width) * 2 -
                                1,
                        )
                        const y = clamp(
                            ((event.clientY - bounds.top) / bounds.height) * 2 -
                                1,
                        )
                        tiltX(-y * 5)
                        tiltY(x * 5)
                        moveX(x * 2)
                        moveY(y * 2)
                    }
                    const visibility = (): void => {
                        if (document.hidden) reset()
                    }

                    seal.addEventListener('pointerenter', enter)
                    seal.addEventListener('pointermove', move)
                    seal.addEventListener('pointerleave', reset)
                    seal.addEventListener('pointercancel', reset)
                    window.addEventListener('scroll', reset, { passive: true })
                    window.addEventListener('blur', reset)
                    window.addEventListener('resize', reset)
                    document.addEventListener('visibilitychange', visibility)
                    return () => {
                        seal.removeEventListener('pointerenter', enter)
                        seal.removeEventListener('pointermove', move)
                        seal.removeEventListener('pointerleave', reset)
                        seal.removeEventListener('pointercancel', reset)
                        window.removeEventListener('scroll', reset)
                        window.removeEventListener('blur', reset)
                        window.removeEventListener('resize', reset)
                        document.removeEventListener(
                            'visibilitychange',
                            visibility,
                        )
                    }
                },
                root,
            )
        }, root)
        disposeMotion = () => {
            media.revert()
            context.revert()
            disposeMotion = undefined
        }
    }

    function cleanupHomepageMotion(): void {
        disposeMotion?.()
    }

    document.addEventListener('astro:page-load', initHomepageMotion)
    document.addEventListener('astro:before-swap', cleanupHomepageMotion)

    if (import.meta.hot) {
        import.meta.hot.dispose(() => {
            cleanupHomepageMotion()
            document.removeEventListener('astro:page-load', initHomepageMotion)
            document.removeEventListener(
                'astro:before-swap',
                cleanupHomepageMotion,
            )
        })
    }
</script>

<style lang="scss">
    .home {
        --different-wdth: 102;
        --different-weight: 250;
        --systems-wdth: 106;
        --systems-weight: 850;
        --same-wdth: 104;
        --same-weight: 320;
        --approach-wdth: 102;
        --approach-weight: 820;
        background: var(--paper);
    }

    .home[data-mode='frontend'] {
        --different-wdth: 58;
        --different-weight: 220;
        --systems-wdth: 88;
        --systems-weight: 760;
        --same-wdth: 112;
        --same-weight: 360;
        --approach-wdth: 132;
        --approach-weight: 700;
    }

    .home[data-mode='backend'] {
        --different-wdth: 92;
        --different-weight: 360;
        --systems-wdth: 136;
        --systems-weight: 900;
        --same-wdth: 72;
        --same-weight: 260;
        --approach-wdth: 102;
        --approach-weight: 790;
    }

    .home[data-mode='reliability'] {
        --different-wdth: 118;
        --different-weight: 320;
        --systems-wdth: 105;
        --systems-weight: 730;
        --same-wdth: 62;
        --same-weight: 240;
        --approach-wdth: 140;
        --approach-weight: 900;
    }

    .hero {
        position: relative;
        isolation: isolate;
        background: var(--paper);
        overflow: clip;
        box-sizing: border-box;
        min-height: 100svh;
        min-height: 100dvh;
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-content: space-between;
        gap: 2rem;
        padding: 1rem var(--page-gutter) 2rem;
    }

    .hero > * {
        min-width: 0;
    }

    .mode-sequencer,
    .statement,
    .reasoning,
    .hero-footer {
        position: relative;
        z-index: 1;
    }

    .mode-sequencer,
    .reasoning,
    .hero-footer {
        z-index: 3;
    }

    .mode-sequencer {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.5rem 1rem;
    }

    .mode-sequencer button {
        min-width: 0;
        min-height: var(--touch-target);
        display: flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.5rem 0;
        color: var(--ink);
        background: transparent;
        border: 0;
        border-bottom: 1px solid var(--rule);
        cursor: pointer;
        font-size: 0.7rem;
        font-variation-settings:
            'wdth' 82,
            'wght' 520;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        white-space: nowrap;
        transition: color 240ms var(--ease-out);

        &[aria-pressed='true'] {
            color: var(--signal);
            border-bottom-color: currentcolor;
            font-variation-settings:
                'wdth' 82,
                'wght' 760;
        }
    }

    #hero-title {
        margin-top: 36px;
    }

    .statement {
        container-type: inline-size;
        display: grid;
        justify-items: start;
        align-content: start;
        gap: 0.5rem;
        font-family: var(--font-display);
        font-weight: 400;
        letter-spacing: -0.035em;
    }

    .statement-line {
        position: relative;
        width: max-content;
        padding-bottom: 1.25rem;
        white-space: nowrap;
        font-size: min(12cqw, 10rem);
        line-height: 0.68;
        transition: font-variation-settings 850ms var(--ease-out);
    }

    .statement-word {
        display: inline-block;
    }

    .statement-different {
        line-height: 0.5;
        font-variation-settings:
            'wdth' var(--different-wdth),
            'wght' var(--different-weight);
    }
    .statement-systems {
        font-variation-settings:
            'wdth' var(--systems-wdth),
            'wght' var(--systems-weight);
    }
    .statement-same {
        font-size: min(16cqw, 10rem);
        font-style: italic;
        font-variation-settings:
            'wdth' var(--same-wdth),
            'wght' var(--same-weight);
    }
    .statement-approach {
        font-variation-settings:
            'wdth' var(--approach-wdth),
            'wght' var(--approach-weight);
    }

    .width-readout {
        max-width: 100%;
        position: absolute;
        // Preserve the offset until the annotation reaches the specimen edge.
        right: max(0px, calc(100% + 50px - 100cqw));
        bottom: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--muted);
        font-size: 0.625rem;
        font-style: normal;
        font-variation-settings:
            'wdth' 78,
            'wght' 550;
        letter-spacing: 0.1em;
        line-height: 1.3;
        text-transform: uppercase;
        pointer-events: none;
        transform: translateX(50px) translateY(-13px);
    }

    .statement-different > .width-readout {
        transform: translateX(50px) translateY(-6px);
    }

    @media (max-width: 760px) {
        .statement-line:not(.statement-different) > .width-readout {
            // Use the reserved caption space when a wide mode reaches the edge.
            transform: translateX(50px) translateY(-13px);
        }
    }

    .readout-line {
        flex-shrink: 1;
        min-width: 0;
        width: 1.5rem;
        border-top: 1px dashed var(--rule);
    }

    .width-readout output {
        font: inherit;
        font-variant-numeric: tabular-nums;
    }
    .width-readout b {
        font-weight: inherit;
    }

    .reasoning {
        padding-top: 1.5rem;
        border-top: 1px solid var(--rule);
    }
    .reasoning dl {
        display: grid;
        margin: 0;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem;
    }
    .reasoning dt {
        margin-bottom: 0.6rem;
        font-size: 0.7rem;
        font-variation-settings:
            'wdth' 72,
            'wght' 690;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }
    .reasoning dd {
        color: var(--muted);
        font-size: 1rem;
        font-variation-settings:
            'wdth' 78,
            'wght' 350;
        line-height: 1.4;
    }

    .hero-footer {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.5rem 2rem;
    }
    .coordinates,
    .process-mantra {
        display: none;
        font-size: 0.65rem;
        font-variation-settings:
            'wdth' 74,
            'wght' 490;
        letter-spacing: 0.14em;
        line-height: 1.45;
        text-transform: uppercase;
    }
    .coordinates {
        color: var(--muted);
    }
    .offer-copy {
        font-size: 1.1rem;
        font-variation-settings:
            'wdth' 74,
            'wght' 390;
        line-height: 1.35;
    }
    .start-project {
        display: flex;
        flex: 1 0 100%;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: var(--touch-target);
        padding-bottom: 0.55rem;
        color: var(--signal);
        border-bottom: 2px solid currentcolor;
        font-size: 0.85rem;
        font-variation-settings:
            'wdth' 82,
            'wght' 650;
        letter-spacing: 0.13em;
        text-decoration: none;
        text-transform: uppercase;
        transition: color 220ms var(--ease-out);

        svg {
            flex: 0 0 1.7rem;
            width: 1.7rem;
            fill: none;
            stroke: currentcolor;
            stroke-linecap: square;
            stroke-width: 1.5;
        }
        &:hover {
            color: var(--ink);
        }
    }

    /* Tablet: give the specimen the full width, with four reasoning columns below. */
    @media (min-width: 761px) {
        .hero {
            gap: 2.5rem;
            padding-block: 1.5rem 2.5rem;
        }
        .mode-sequencer {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1.5rem;
        }
        .statement {
            gap: 0.75rem;
        }
        .statement-line {
            padding-bottom: 1.5rem;
        }
        .width-readout {
            max-width: 100%;
            font-size: 0.7rem;
        }
        .readout-line {
            flex-shrink: 1;
            min-width: 0;
            width: 3rem;
        }
        .reasoning dl {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
        .start-project {
            flex: 0 0 12rem;
            margin-left: auto;
        }
    }

    /* Desktop: independent tracks protect the specimen and the reasoning column. */
    @media (min-width: 1201px) {
        .hero {
            grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.34fr);
            column-gap: 3rem;
        }
        .statement {
            grid-column: 1;
        }
        .reasoning {
            grid-column: 2;
            align-self: center;
            padding: 1rem 0 0 1.5rem;
            border-top: 0;
            border-left: 1px solid var(--rule);
        }
        .reasoning dl {
            grid-template-columns: 1fr;
            gap: 2rem;
            margin-top: 0;
        }
        .hero-footer {
            grid-column: 1 / -1;
        }
        .coordinates,
        .process-mantra {
            display: block;
        }
        .offer-copy {
            margin-left: auto;
        }
        .start-project {
            margin-left: 0;
        }
    }

    .thinking {
        display: grid;
        grid-template-columns: minmax(24rem, 0.88fr) 1fr;
        gap: 0px clamp(4rem, 9vw, 10rem);
        padding: clamp(5rem, 10vw, 10rem) var(--page-gutter);
        color: var(--paper);
        border-top: 1px solid var(--ink);
        background: var(--ink);
    }

    .thinking-heading {
        position: sticky;
        top: 2rem;
        align-self: start;
    }

    .thinking h2 {
        font-size: clamp(3.8rem, 7.2vw, 8.4rem);
        font-variation-settings:
            'wdth' 74,
            'wght' 320;
        letter-spacing: -0.04em;
        line-height: 0.82;
    }

    .thinking h2 span {
        color: var(--signal);
        font-style: italic;
        font-weight: 760;
    }

    .thinking ol {
        list-style: none;
    }

    .thinking li {
        display: grid;
        grid-template-columns: 3rem 1fr;
        gap: clamp(1.25rem, 3vw, 3rem);
        padding: 2rem 0 4rem;
        border-top: 1px solid #565655;
    }

    .thinking li > span {
        color: var(--signal);
        font-size: 0.7rem;
        letter-spacing: 0.15em;
    }

    .thinking li h3 {
        margin-bottom: 1rem;
        font-size: clamp(1.7rem, 2.7vw, 3rem);
        font-variation-settings:
            'wdth' 82,
            'wght' 560;
        line-height: 1;
    }

    .thinking li p {
        max-width: 42ch;
        color: #d0cbc3;
        font-size: clamp(1rem, 1.25vw, 1.25rem);
        font-variation-settings:
            'wdth' 84,
            'wght' 350;
        line-height: 1.5;
    }

    .thinking li strong {
        display: block;
        margin-bottom: 0.65rem;
        color: var(--heritage-amber);
        font-family: var(--font-body);
