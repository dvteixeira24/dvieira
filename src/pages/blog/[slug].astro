---
import Layout from '../../layouts/Layout.astro'
import Giscus from '../../components/Giscus.astro'

import { getCollection, render } from 'astro:content'
import { formatDate, publishedPosts } from '../../lib/blog'

export const prerender = true

export async function getStaticPaths() {
    const posts = publishedPosts(await getCollection('blog'), {
        includeDrafts: import.meta.env.DEV,
    })
    return posts.map(post => ({
        params: { slug: post.id },
        props: { post },
    }))
}

const { post } = Astro.props
const { Content } = await render(post)

const tags = post.data.tags ?? []
---

<Layout
    title={`${post.data.title} | Daniel Vieira Teixeira`}
    description={post.data.description}
    canonical={`https://dvieira.dev/blog/${post.id}`}
    article={{ publishedTime: post.data.pubDate, modifiedTime: post.data.updated }}
>
    <main class="post">
        <article class="post-article">
            <header class="page-hero post-hero">
                <h1>{post.data.title}</h1>
                <div class="post-byline">
                    <span
                        class="post-byline-plate"
                        style={`--plate: url(/images/portrait-head.webp)`}
                    >
                        <img
                            src="/images/portrait-head.webp"
                            alt=""
                            width="320"
                            height="320"
                            loading="eager"
                            decoding="async"
                        />
                    </span>
                    <p>
                        <strong>Daniel Vieira Teixeira</strong>
                        <time datetime={post.data.pubDate.toISOString()}>
                            {formatDate(post.data.pubDate)}
                        </time>
                    </p>
                </div>
                {
                    import.meta.env.DEV && post.data.draft && (
                        <p class="post-draft">Draft</p>
                    )
                }
                {
                    post.data.updated && (
                        <p class="post-updated">
                            Updated {formatDate(post.data.updated)}
                        </p>
                    )
                }
            </header>

            {
                tags.length > 0 && (
                    <ul class="post-tags" aria-label="Topics">
                        {tags.map(tag => <li>{tag}</li>)}
                    </ul>
                )
            }

            {
                post.data.cover && (
                    <img
                        class="post-cover"
                        src={post.data.cover}
                        alt=""
                        loading="lazy"
                    />
                )
            }

            <div class="post-body">
                <Content />
            </div>

            <Giscus />

            <footer class="post-back">
                <a href="/blog" class="post-back-link">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M21 12H3m7-7-7 7 7 7"></path>
                    </svg>
                    All writing
                </a>
            </footer>
        </article>
    </main>
</Layout>

<style lang="scss">
    .post {
        background: transparent;
    }

    .post-article {
        max-width: min(46rem, calc(100% - 2 * var(--page-gutter)));
        margin: 0 auto;
        padding: clamp(3rem, 6vw, 6rem) 0;
    }

    .post-hero {
        border-bottom: 1px solid var(--ink);
        padding-bottom: clamp(1.75rem, 3vw, 2.5rem);
    }

    .post-byline {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 1.75rem;
    }

    .post-byline-plate {
        position: relative;
        flex: none;
        width: 3rem;
        height: 3rem;
    }

    .post-byline-plate::before {
        position: absolute;
        inset: 0;
        content: '';
        background: var(--signal);
        -webkit-mask-image: var(--plate);
        mask-image: var(--plate);
        -webkit-mask-size: 100% 100%;
        mask-size: 100% 100%;
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        transform: translate(4px, 0);
    }

    .post-byline-plate :global(img) {
        position: relative;
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .post-byline p {
        display: grid;
        gap: 0.2rem;
    }

    .post-byline strong {
        font-family: var(--font-human);
        font-size: 1.02rem;
        font-weight: 650;
        line-height: 1.1;
    }

    .post-byline time {
        color: var(--muted);
        font-size: 0.72rem;
        font-variation-settings:
            'wdth' 85,
            'wght' 560;
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.1em;
        line-height: 1.5;
        text-transform: uppercase;
    }

    .post-hero h1 {
        max-width: 20ch;
        font-family: var(--font-human);
        font-size: clamp(2.25rem, 5vw, 4rem);
        font-weight: 650;
        letter-spacing: -0.025em;
        line-height: 1.02;
        text-wrap: balance;
    }

    .post-draft {
        width: fit-content;
        margin-top: 1rem;
        padding: 0.35rem 0.6rem;
        border: 1px solid var(--signal);
        color: var(--signal);
        font-size: 0.75rem;
        font-variation-settings:
            'wdth' 85,
            'wght' 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        line-height: 1.3;
    }

    .post-updated {
        margin-top: 1rem;
        color: var(--muted);
        font-size: 0.85rem;
        font-variation-settings:
            'wdth' 85,
            'wght' 460;
        line-height: 1.5;
    }

    .post-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 1.5rem 0 0;
        padding: 0;
        list-style: none;
    }

    .post-tags li {
        padding: 0.4rem 0.6rem;
        border: 1px solid var(--rule-ink);
        font-size: 0.75rem;
        font-variation-settings:
            'wdth' 85,
            'wght' 460;
        letter-spacing: 0.02em;
        line-height: 1.3;
    }

    .post-cover {
        display: block;
        width: 100%;
        height: auto;
        margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
        border: 1px solid var(--rule);
    }

    .post-body {
        margin-top: clamp(2rem, 4vw, 3rem);
        max-width: 66ch;
        font-family: var(--font-human);
        font-size: clamp(1.12rem, 1.3vw, 1.28rem);
        font-weight: 420;
        line-height: 1.7;
        color: var(--ink);
    }

    .post-body :global(p:first-of-type::first-letter) {
        float: left;
        margin: 0.06em 0.09em 0 0;
        font-size: 3.9em;
        font-weight: 600;
        line-height: 0.78;
    }

    .post-body :global(p) {
        margin: 0 0 1.4em;
    }

    .post-body :global(h2),
    .post-body :global(h3) {
        margin: 2em 0 0.75em;
        font-family: var(--font-human);
        font-weight: 650;
        letter-spacing: -0.02em;
        line-height: 1.1;
        text-wrap: balance;
    }

    .post-body :global(h2) {
        font-size: clamp(1.6rem, 3vw, 2.1rem);
    }

    .post-body :global(h3) {
        font-size: clamp(1.3rem, 2.4vw, 1.6rem);
    }

    .post-body :global(a) {
        color: var(--signal);
        text-decoration: underline;
        text-underline-offset: 0.22em;
    }

    .post-body :global(ul),
    .post-body :global(ol) {
        margin: 0 0 1.4em;
        padding-left: 1.4em;
    }

    .post-body :global(li) {
        margin: 0.4em 0;
    }

    .post-body :global(li::marker) {
        color: var(--signal);
    }

    .post-body :global(blockquote) {
        margin: 1.6em 0;
        padding-left: 1.25rem;
        border-left: 2px solid var(--signal);
        color: var(--muted);
        font-family: var(--font-human);
        font-size: 1.1em;
        font-style: italic;
    }

    .post-body :global(code) {
        padding: 0.1em 0.35em;
        background: var(--paper-soft);
        border: 1px solid var(--rule);
        font-family: 'Fragment Mono', monospace;
        font-size: 0.85em;
    }

    .post-body :global(pre) {
        margin: 1.6em 0;
        padding: 1.25rem;
        overflow-x: auto;
        background: var(--charcoal);
        color: var(--paper-soft);
        border: 1px solid var(--ink);
        border-left: 3px solid var(--signal);
    }

    .post-body :global(pre code) {
        padding: 0;
        background: transparent;
        border: 0;
        color: inherit;
    }

    .post-body :global(hr) {
        margin: 2.5em 0;
        border: 0;
        border-top: 1px solid var(--rule);
    }

    .post-body :global(img) {
        display: block;
        max-width: 100%;
        height: auto;
        margin: 2em auto;
    }

    .post-back {
        margin-top: clamp(2.5rem, 5vw, 4rem);
        padding-top: 1.5rem;
        border-top: 1px solid var(--rule);
    }

    .post-back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        min-height: var(--touch-target);
        color: var(--ink);
        font-size: 0.9rem;
        font-variation-settings:
            'wdth' 85,
            'wght' 560;
        text-decoration: none;
        transition: color 220ms var(--ease-out);
    }

    .post-back-link:hover,
    .post-back-link:focus-visible {
        color: var(--signal);
    }

    .post-back-link svg {
        width: 1.1rem;
        height: 1.1rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.5;
    }
</style>
