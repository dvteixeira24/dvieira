---
import Layout from '../../layouts/Layout.astro'
import BlogPostRow from '../../components/BlogPostRow.astro'
import { getCollection } from 'astro:content'
import { postHref, publishedPosts } from '../../lib/blog'

export const prerender = true

const posts = publishedPosts(await getCollection('blog'), {
    includeDrafts: import.meta.env.DEV,
})
---

<Layout
    title="Writing | Daniel Vieira Teixeira"
    description="Notes and essays on software engineering from Daniel Vieira Teixeira — full-stack delivery, quality, and reliability."
    canonical="https://dvieira.dev/blog"
>
    <main class="blog">
        <header class="page-hero blog-hero">
            <div class="blog-paper" aria-hidden="true">
                <span class="blog-registration blog-registration-top-left"></span>
                <span class="blog-registration blog-registration-top-right"></span>
                <span class="blog-registration blog-registration-bottom-left"></span>
                <span class="blog-registration blog-registration-bottom-right"></span>
            </div>
            <h1>Writing</h1>
            <p class="blog-intro">
                Notes on building software — what I've learned, how I think
                about the work, and the systems around it.
            </p>
            <a class="rss-link" href="/rss.xml">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"></path>
                    <circle cx="5" cy="19" r="1.6"></circle>
                </svg>
                RSS feed
            </a>
        </header>

        {
            posts.length === 0 ? (
                <p class="blog-empty">No posts yet — check back soon.</p>
            ) : (
                <ol class="blog-list">
                    {posts.map(post => (
                        <BlogPostRow
                            href={postHref(post.id)}
                            title={post.data.title}
                            description={post.data.description}
                            pubDate={post.data.pubDate}
                            tags={post.data.tags}
                        />
                    ))}
                </ol>
            )
        }
    </main>
</Layout>

<style lang="scss">
    .blog {
        background: var(--paper);
    }

    .blog-hero {
        position: relative;
        padding: clamp(2rem, 4vw, 3.25rem) var(--page-gutter);
        border-bottom: 1px solid var(--ink);
    }

    .blog-paper {
        position: absolute;
        z-index: 0;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        color: var(--ink);
    }

    .blog-paper::before {
        content: '';
        position: absolute;
        inset: 0;
        opacity: 0.12;
        background-image: radial-gradient(
            circle,
            currentcolor 0.9px,
            transparent 1px
        );
        background-size: 32px 32px;
        // Clear the dot field behind the headline so the display type stays crisp.
        mask-image: radial-gradient(
            ellipse 62% 52% at 20% 30%,
            transparent 32%,
            black 100%
        );
    }

    .blog-registration {
        position: absolute;
        width: 9px;
        height: 9px;
        opacity: 0.1;

        &::before,
        &::after {
            content: '';
            position: absolute;
            background: currentcolor;
        }

        &::before {
            top: 4px;
            width: 9px;
            height: 1px;
        }

        &::after {
            left: 4px;
            width: 1px;
            height: 9px;
        }
    }

    .blog-registration-top-left,
    .blog-registration-top-right {
        top: 16%;
    }

    .blog-registration-bottom-left,
    .blog-registration-bottom-right {
        bottom: 18%;
    }

    .blog-registration-top-left,
    .blog-registration-bottom-left {
        left: 12px;
    }

    .blog-registration-top-right,
    .blog-registration-bottom-right {
        right: 12px;
    }

    .blog-hero h1 {
        position: relative;
        z-index: 1;
        font-size: clamp(3.5rem, 6vw, 6rem);
        font-variation-settings:
            'wdth' 74,
            'wght' 330;
        letter-spacing: -0.04em;
        line-height: 0.95;
    }

    .blog-intro {
        position: relative;
        z-index: 1;
        max-width: 44ch;
        margin-top: 1.25rem;
        font-family: var(--font-human);
        font-size: clamp(1.35rem, 2.2vw, 1.9rem);
        font-weight: 620;
        letter-spacing: -0.015em;
        line-height: 1.25;
        text-wrap: balance;
    }

    .rss-link {
        position: relative;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        min-height: var(--touch-target);
        margin-top: 1.25rem;
        color: var(--ink);
        font-size: 0.85rem;
        font-variation-settings:
            'wdth' 85,
            'wght' 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        text-decoration: none;
        transition: color 220ms var(--ease-out);
    }

    .rss-link:hover,
    .rss-link:focus-visible {
        color: var(--signal);
    }

    .rss-link svg {
        width: 1rem;
        height: 1rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.75;
    }

    .blog-list {
        margin: 0;
        padding: 0 var(--page-gutter);
        list-style: none;
    }

    .blog-empty {
        padding: clamp(2rem, 4vw, 4rem) var(--page-gutter);
        color: var(--muted);
        font-family: var(--font-human);
        font-size: 1.25rem;
        line-height: 1.5;
    }

    @media (max-width: 760px) {
        .blog-paper::before {
            background-size: 28px 28px;
            mask-image: radial-gradient(
                ellipse 80% 45% at 50% 28%,
                transparent 38%,
                black 100%
            );
        }

        .blog-registration-top-right,
        .blog-registration-bottom-left {
            display: none;
        }
    }
</style>
