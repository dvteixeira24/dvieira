<Layout title="Biography | Daniel Vieira Teixeira">
    <main>
        <h1>Biography</h1>
        <section>
            <p><strong>Daniel Vieira Teixeira</strong></p>
            <p>Cape Town, South Africa</p>
            <p>
                Full Stack Software Engineer with strong TypeScript expertise
                and 5+ years of experience across frontend, backend, and QA
