---
import { ClientRouter } from 'astro:transitions'
import Navigation from '../components/Navigation.astro'
import SEO from '../components/SEO.astro'
import heritageTexture from '../assets/mike-hindle-Js5Qi_X1qzo-unsplash.jpg'

interface Props {
    title?: string
    description?: string
    canonical?: string
    noindex?: boolean
    article?: {
        publishedTime: Date
        modifiedTime?: Date
    }
}

const { title, description, canonical, noindex, article } = Astro.props
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link
            rel="icon"
            href="/favicon.ico?v=dv-cut-1"
            sizes="16x16 32x32 48x48"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32x32.png?v=dv-cut-1"
        />
        <link
            rel="icon"
            type="image/svg+xml"
            sizes="any"
            href="/favicon.svg?v=dv-cut-1"
        />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png?v=dv-cut-1"
        />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="theme-color" content="#f7eae8" />
        <meta name="generator" content={Astro.generator} />
        <script
            defer
            src="https://al.d99.xyz/script.js"
            data-website-id="d140b4d1-1247-49ba-b48e-f570b75d61b3"></script>
        <SEO {title} {description} {canonical} {noindex} {article} />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Writing — RSS"
            href="/rss.xml"
        />
        <ClientRouter />
    </head>
    <body style={`--heritage-texture: url(${heritageTexture.src});`}>
        <slot />
        <Navigation />
        <script is:inline data-astro-rerun>
            ;(() => {
                const reduceMotion = window.matchMedia(
                    '(prefers-reduced-motion: reduce)',
                ).matches
                const selectors = [
                    '.section-intro > *',
                    '.intervention',
                    '.thinking-heading',
                    '.thinking li',
                    '.closing > *',
                    '.page-hero > *',
                    '.contact-context > *',
                    '.contact-form-section',
                    '.page-cta > *',
                ]
                const units = [
                    ...document.querySelectorAll(selectors.join(',')),
                ]

                if (window.__portfolioRevealObserver) {
                    window.__portfolioRevealObserver.disconnect()
                }

                units.forEach((unit, index) => {
                    unit.classList.add('reveal-unit')
                    unit.style.setProperty(
                        '--reveal-delay',
                        `${(index % 3) * 70}ms`,
                    )
                    if (reduceMotion) unit.classList.add('is-visible')
                })

                if (reduceMotion) return

                const observer = new IntersectionObserver(
                    entries => {
                        entries.forEach(entry => {
                            if (!entry.isIntersecting) return
                            entry.target.classList.add('is-visible')
                            observer.unobserve(entry.target)
                        })
                    },
                    { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
                )

                units.forEach(unit => observer.observe(unit))
                window.__portfolioRevealObserver = observer
            })()
        </script>
    </body>
</html>

<style is:global lang="scss">
    @font-face {
        font-family: 'Anybody';
        src: url('/font/Anybody-Variable.ttf') format('truetype-variations');
        font-style: normal;
        font-weight: 100 900;
        font-stretch: 50% 150%;
        font-display: swap;
    }

    @font-face {
        font-family: 'Anybody';
        src: url('/font/Anybody-Italic-Variable.ttf')
            format('truetype-variations');
        font-style: italic;
        font-weight: 100 900;
        font-stretch: 50% 150%;
        font-display: swap;
    }

    @font-face {
        font-family: 'Newsreader';
        src: url('/font/Newsreader-VariableFont_opsz,wght.ttf')
            format('truetype-variations');
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
    }

    @font-face {
        font-family: 'Newsreader';
        src: url('/font/Newsreader-Italic-VariableFont_opsz,wght.ttf')
            format('truetype-variations');
        font-style: italic;
        font-weight: 100 900;
        font-display: swap;
    }

    :root {
        color-scheme: light;
        --font-display: 'Anybody', 'Arial Narrow', sans-serif;
        --font-body: 'Anybody', system-ui, sans-serif;
        --font-human: 'Newsreader', Georgia, serif;
        --paper: #f7eae8;
        --paper-deep: #e8e5de;
        --ink: #080909;
        --muted: #5f5f5f;
        --rule: #b0b0ad;
        --signal: #244bd8;
        --signal-soft: #dce3ff;
        --error: #bb271a;
        --success: #175b3b;
        --heritage-amber: #ffc078;
        --heritage-amber-ink: #884000;
        --heritage-cream: #fff4e6;
        --heritage-charcoal: #141414;
        --heritage-rule: #5d554c;
        --rail-width: clamp(5.5rem, 6.35vw, 6.5rem);
        --page-gutter: clamp(1.25rem, 2.5vw, 2.75rem);
        --touch-target: 2.75rem;
        --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;
        margin: 0;
    }

    html {
        min-width: 20rem;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--font-body);
        font-synthesis: none;
        -webkit-font-smoothing: antialiased;
        text-rendering: geometricprecision;
        scroll-behavior: smooth;
        scrollbar-color: var(--signal) var(--paper-deep);
        scrollbar-width: thin;
    }

    body {
        min-height: 100svh;
        padding-left: var(--rail-width);
        overflow-x: clip;
        background: var(--paper);
    }

    .statement,
    .site-rail,
    .mode-sequencer,
    .width-readout,
    button {
        -webkit-user-select: none;
        user-select: none;
    }

    input,
    textarea,
    [contenteditable='true'] {
        -webkit-user-select: text;
        user-select: text;
    }

    ::selection {
        color: var(--paper);
        background: var(--signal);
    }

    :focus-visible {
        outline: 2px solid var(--signal);
        outline-offset: 5px;
    }

    a {
        color: inherit;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.24em;
    }

    button,
    input,
    textarea {
        color: inherit;
        font: inherit;
        border-radius: 0;
    }

    button,
    a {
        -webkit-tap-highlight-color: transparent;
    }

    .reveal-unit {
        opacity: 0;
        transform: translateY(1.75rem);
        transition:
            opacity 700ms var(--ease-out) var(--reveal-delay, 0ms),
            transform 900ms var(--ease-out) var(--reveal-delay, 0ms);
        will-change: opacity, transform;
    }

    .reveal-unit.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    @media (max-width: 760px) {
        :root {
            --rail-width: 0px;
        }

        body {
            padding-top: 0;
            padding-right: 0;
            padding-bottom: calc(5.75rem + env(safe-area-inset-bottom));
            padding-left: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        html {
            scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
            scroll-behavior: auto !important;
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
        }
    }
</style>
