<div class="hero-paper" aria-hidden="true"><canvas></canvas></div>

<script>
    let paper: HTMLCanvasElement | undefined

    function createPaper(): HTMLCanvasElement {
        const canvas = document.createElement('canvas')
        canvas.width = 640
        canvas.height = 480
        const context = canvas.getContext('2d')
        if (!context) return canvas
        const image = context.createImageData(canvas.width, canvas.height)
        const hash = (x: number, y: number): number => {
            let seed = Math.imul(x, 374761393) + Math.imul(y, 668265263)
            seed = Math.imul(seed ^ (seed >>> 13), 1274126177)
            return ((seed ^ (seed >>> 16)) >>> 0) / 4294967295
        }
        const noise = (x: number, y: number): number => {
            const ix = Math.floor(x)
            const iy = Math.floor(y)
            const fx = x - ix
            const fy = y - iy
            const sx = fx * fx * (3 - 2 * fx)
            const sy = fy * fy * (3 - 2 * fy)
            const top = hash(ix, iy) * (1 - sx) + hash(ix + 1, iy) * sx
            const bottom =
                hash(ix, iy + 1) * (1 - sx) + hash(ix + 1, iy + 1) * sx
            return top * (1 - sy) + bottom * sy
        }
        // Domain-warped veins and stretched fibers give the stock a material structure.
        // Bake once; ambient movement only transforms the finished canvas.
        for (let y = 0; y < canvas.height; y += 1) {
            for (let x = 0; x < canvas.width; x += 1) {
                const u = x / canvas.width
                const v = y / canvas.height
                const warp = noise(u * 3 + 17, v * 3 + 9)
                const bend = noise(u * 5 + warp * 2, v * 4 + 31)
                const cloud = noise(u * 4 + bend * 3, v * 5 + warp * 3)
                const vein = Math.pow(
                    Math.abs(Math.sin((v * 3 + warp * 2 + bend) * 12)),
                    14,
                )
                const fiber = noise(u * 170 + warp * 24, v * 24 + bend * 8)
                const grain = hash(x + 53, y + 97)
                const value = Math.round(
                    174 + cloud * 56 - vein * 53 + fiber * 20 + grain * 12,
                )
                const index = (y * canvas.width + x) * 4
                image.data[index] = value
                image.data[index + 1] = value - 6
                image.data[index + 2] = value + 4
                image.data[index + 3] = 255
            }
        }
        context.putImageData(image, 0, 0)
        return canvas
    }

    function initPaper(): void {
        const canvas =
            document.querySelector<HTMLCanvasElement>('.hero-paper canvas')
        if (!canvas) return
        paper ??= createPaper()
        canvas.width = paper.width
        canvas.height = paper.height
        canvas.getContext('2d')?.drawImage(paper, 0, 0)
    }

    document.addEventListener('astro:page-load', initPaper)
    if (import.meta.hot) {
        import.meta.hot.dispose(() => {
            document.removeEventListener('astro:page-load', initPaper)
            paper = undefined
        })
    }
</script>

<style lang="scss">
    .hero-paper {
        position: absolute;
        z-index: 0;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        mix-blend-mode: multiply;
        opacity: 0.07;
    }

    canvas {
        display: block;
        width: 110%;
        height: 110%;
        transform: translate(-3%, -3%);
    }

    @media (min-width: 761px) and (prefers-reduced-motion: no-preference) {
        canvas {
            animation: paper-drift 48s ease-in-out infinite alternate;
            animation-play-state: paused;
        }

        :global(.home[data-hero-ambient='running']) canvas {
            animation-play-state: running;
        }
    }

    @keyframes paper-drift {
        from {
            transform: translate(-3%, -3%) scale(1);
        }
        to {
            transform: translate(-1%, -1.5%) scale(1.015);
        }
    }
</style>
