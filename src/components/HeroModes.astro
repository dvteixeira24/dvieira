---
import { heroModes } from '../lib/hero-modes'
const initial = heroModes[0]
const words = ['Different', initial.noun, 'Same', 'approach.']
---

<div class="mode-toolbar">
    <div class="mode-sequencer" role="group" aria-label="Engineering modes">
        {
            heroModes.map((mode, index) => (
                <button
                    type="button"
                    data-role={mode.id}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                    aria-controls={`mode-detail-${mode.id}`}
                    disabled
                >
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    {mode.label}
                </button>
            ))
        }
    </div>
    <button class="rotation-control" type="button" hidden>
        <svg viewBox="0 0 16 16" aria-hidden="true">
            <path class="pause-symbol" d="M5 3v10M11 3v10"></path>
            <path class="play-symbol" d="m5 3 7 5-7 5Z"></path>
        </svg>
        <span>Pause cycle</span>
    </button>
</div>

<div class="mode-stage">
    <h1
        id="hero-title"
        class="statement"
        aria-label={`Different ${initial.noun} Same approach.`}
    >
        {
            words.map((word, index) => (
                <span class="statement-line" aria-hidden="true">
                    <span class="line-marker">
                        {String(index + 1).padStart(2, '0')}
                    </span>
                    <span class="statement-word" data-word={index}>
                        {word}
                    </span>
                    <span class="role-annotation">
                        <span class="annotation-rule" />
                        <span data-cue={index}>{initial.cues[index]}</span>
                    </span>
                </span>
            ))
        }
    </h1>
    <div class="mode-notes">
        {
            heroModes.map((mode, index) => (
                <section
                    id={`mode-detail-${mode.id}`}
                    class="mode-detail"
                    aria-labelledby={`mode-title-${mode.id}`}
                    hidden={index !== 0}
                >
                    <h2 id={`mode-title-${mode.id}`}>{mode.title}</h2>
                    <p>{mode.description}</p>
                    <p class="mode-capabilities">{mode.detail}</p>
                    <a href={mode.href}>
                        <span>{mode.evidence}</span>
                        <svg viewBox="0 0 20 20" aria-hidden="true">
                            <path d="M4 16 16 4M4 4h12v12" />
                        </svg>
                    </a>
                </section>
            ))
        }
    </div>
</div>

<script>
    import { gsap } from 'gsap'
    import { heroModes } from '../lib/hero-modes'

    let disposeModes: (() => void) | undefined

    function initModes(): void {
        disposeModes?.()
        const home = document.querySelector<HTMLElement>('.home')
        const hero = home?.querySelector<HTMLElement>('.hero')
        const controls =
            home?.querySelectorAll<HTMLButtonElement>('[data-role]')
        const rotation =
            home?.querySelector<HTMLButtonElement>('.rotation-control')
        const heading = home?.querySelector<HTMLElement>('#hero-title')
        if (!home || !hero || !controls || !rotation || !heading) return

        // Warm the alternate face before its first automatic appearance.
        void document.fonts.load('1em "Fragment Mono"').catch(() => {})
        const listeners = new AbortController()
        const options = { signal: listeners.signal }
        const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)')
        const words = Array.from(
            heading.querySelectorAll<HTMLElement>('.statement-word'),
        )
        const captions = Array.from(
            heading.querySelectorAll<HTMLElement>('.role-annotation'),
        )
        let transition: gsap.core.Timeline | undefined
        let motion = gsap.context(() => {}, heading)
        const ghosts: HTMLElement[] = []

        function settleTransition(): void {
            transition?.progress(1).kill()
            transition = undefined
            motion.revert()
            motion = gsap.context(() => {}, heading!)
            ghosts.splice(0).forEach(ghost => ghost.remove())
        }

        function captureWord(word: HTMLElement) {
            const style = getComputedStyle(word)
            return {
                bounds: word.getBoundingClientRect(),
                text: word.textContent,
                fontFamily: style.fontFamily,
                fontStyle: style.fontStyle,
                fontWeight: style.fontWeight,
                fontSize: style.fontSize,
                fontVariationSettings: style.fontVariationSettings,
                letterSpacing: style.letterSpacing,
                textTransform: style.textTransform,
                color: style.color,
            }
        }

        let current = 0
        let paused = reducedMotion.matches
        let visible = false
        let hovering = hero.matches(':hover')
        let timer: number | undefined

        function stopTimer(): void {
            window.clearInterval(timer)
            timer = undefined
        }

        function updatePlayback(): void {
            stopTimer()
            rotation!.dataset.paused = String(paused)
            rotation!.querySelector('span')!.textContent = paused
                ? 'Resume cycle'
                : 'Pause cycle'
            if (paused || !visible || hovering || document.hidden) return
            timer = window.setInterval(
                () => selectMode((current + 1) % heroModes.length),
                5000,
            )
        }

        function selectMode(index: number, animate = true): void {
            if (animate && index === current) return
            settleTransition()
            const before = words.map(captureWord)
            const captionBounds = captions.map(caption =>
                caption.getBoundingClientRect(),
            )
            current = index
            const mode = heroModes[index]
            home!.dataset.mode = mode.id
            heading!.setAttribute(
                'aria-label',
                `Different ${mode.noun} Same approach.`,
            )
            heading!.querySelector('[data-word="1"]')!.textContent = mode.noun
            heading!
                .querySelectorAll<HTMLElement>('[data-cue]')
                .forEach((cue, i) => {
                    cue.textContent = mode.cues[i]
                })
            controls!.forEach((button, i) =>
                button.setAttribute('aria-pressed', String(i === index)),
            )
            home!
                .querySelectorAll<HTMLElement>('.mode-detail')
                .forEach((panel, i) => {
                    panel.hidden = i !== index
                })

            if (!animate || reducedMotion.matches) return
            const after = words.map(captureWord)
            motion.add(() => {
                transition = gsap.timeline({
                    defaults: { duration: 0.62, ease: 'power3.inOut' },
                    onComplete: () => {
                        ghosts.splice(0).forEach(ghost => ghost.remove())
                    },
                })
                words.forEach((word, i) => {
                    const from = before[i]
                    const to = after[i]
                    const at = i * 0.035
                    const sameFace =
                        from.fontFamily === to.fontFamily &&
                        from.fontStyle === to.fontStyle &&
                        from.text === to.text

                    if (sameFace) {
                        // Interpolate the actual variable axes when the glyphs share a face.
                        transition!.fromTo(
                            word,
                            {
                                fontVariationSettings:
                                    from.fontVariationSettings,
                                fontSize: from.fontSize,
                                color: from.color,
                                x: from.bounds.left - to.bounds.left,
                                y: from.bounds.top - to.bounds.top,
                            },
                            {
                                fontVariationSettings: to.fontVariationSettings,
                                fontSize: to.fontSize,
                                color: to.color,
                                x: 0,
                                y: 0,
                                clearProps:
                                    'fontVariationSettings,fontSize,color,transform',
                            },
                            at,
                        )
                    } else {
                        // Different font outlines cannot interpolate. Register both impressions
                        // to the same moving box, then dissolve between them.
                        const ghost = word.cloneNode(true) as HTMLElement
                        ghost.removeAttribute('data-word')
                        ghost.classList.add('statement-ghost')
                        ghost.setAttribute('aria-hidden', 'true')
                        ghost.textContent = from.text
                        const row = word.parentElement!
                        const rowBounds = row.getBoundingClientRect()
                        Object.assign(ghost.style, {
                            position: 'absolute',
                            left: `${from.bounds.left - rowBounds.left}px`,
                            top: `${from.bounds.top - rowBounds.top}px`,
                            fontFamily: from.fontFamily,
                            fontStyle: from.fontStyle,
                            fontWeight: from.fontWeight,
                            fontSize: from.fontSize,
                            fontVariationSettings: from.fontVariationSettings,
                            letterSpacing: from.letterSpacing,
                            textTransform: from.textTransform,
                            color: from.color,
                            margin: '0',
                            clipPath: 'none',
                            pointerEvents: 'none',
                            transformOrigin: '0 0',
                        })
                        row.append(ghost)
                        ghosts.push(ghost)
                        transition!.fromTo(
                            word,
                            {
                                x: from.bounds.left - to.bounds.left,
                                y: from.bounds.top - to.bounds.top,
                                scaleX: from.bounds.width / to.bounds.width,
                                scaleY: from.bounds.height / to.bounds.height,
                                opacity: 0,
                                transformOrigin: '0 0',
                            },
                            {
                                x: 0,
                                y: 0,
                                scaleX: 1,
                                scaleY: 1,
                                clearProps: 'transform,transformOrigin',
                            },
                            at,
                        )
                        transition!.to(
                            ghost,
                            {
                                x: to.bounds.left - from.bounds.left,
                                y: to.bounds.top - from.bounds.top,
                                scaleX: to.bounds.width / from.bounds.width,
                                scaleY: to.bounds.height / from.bounds.height,
                            },
                            at,
                        )
                        transition!.to(
                            ghost,
                            {
                                opacity: 0,
                                duration: 0.24,
                                ease: 'power1.in',
                            },
                            at + 0.04,
                        )
                        transition!.to(
                            word,
                            {
                                opacity: 1,
                                duration: 0.3,
                                ease: 'power1.out',
                                clearProps: 'opacity',
                            },
                            at + 0.14,
                        )
                    }
                })
                captions.forEach((caption, i) => {
                    const bounds = caption.getBoundingClientRect()
                    transition!.fromTo(
                        caption,
                        {
                            x: captionBounds[i].left - bounds.left,
                            y: captionBounds[i].top - bounds.top,
                            opacity: 0.35,
                        },
                        {
                            x: 0,
                            y: 0,
                            opacity: 1,
                            clearProps: 'transform,opacity',
                        },
                        i * 0.035,
                    )
                })
            })
        }

        controls.forEach((control, index) => {
            control.disabled = false
            control.addEventListener(
                'click',
                () => {
                    paused = true
                    selectMode(index)
                    updatePlayback()
                },
                options,
            )
        })
        rotation.hidden = false
        rotation.addEventListener(
            'click',
            () => {
                paused = !paused
                updatePlayback()
            },
            options,
        )
        hero.addEventListener(
            'focusin',
            event => {
                // Focusing the playback control must not change its action before click.
                if (
                    event.target === rotation &&
                    !rotation.matches(':focus-visible')
                )
                    return
                paused = true
                updatePlayback()
            },
            options,
        )
        hero.addEventListener(
            'pointerenter',
            event => {
                if (event.pointerType !== 'mouse') return
                hovering = true
                updatePlayback()
            },
            options,
        )
        hero.addEventListener(
            'pointerleave',
            event => {
                if (event.pointerType !== 'mouse') return
                hovering = false
                updatePlayback()
            },
            options,
        )
        document.addEventListener('visibilitychange', updatePlayback, options)
        reducedMotion.addEventListener(
            'change',
            () => {
                if (reducedMotion.matches) {
                    paused = true
                    settleTransition()
                }
                updatePlayback()
            },
            options,
        )
        const observer = new IntersectionObserver(entries => {
            visible = entries[0].isIntersecting
            updatePlayback()
        })
        observer.observe(hero)
        window.addEventListener('resize', settleTransition, options)
        selectMode(0, false)
        updatePlayback()
        disposeModes = () => {
            stopTimer()
            settleTransition()
            motion.revert()
            observer.disconnect()
            listeners.abort()
        }
    }

    document.addEventListener('astro:page-load', initModes)
    document.addEventListener('astro:before-swap', () => disposeModes?.())
</script>

<style lang="scss">
    @font-face {
        font-family: 'Fragment Mono';
        src: url('/font/FragmentMono-Regular.ttf') format('truetype');
        font-style: normal;
        font-weight: 400;
        font-display: swap;
    }

    .mode-toolbar {
        display: flex;
        align-items: start;
        gap: clamp(1rem, 4vw, 4rem);
        position: relative;
        z-index: 3;
    }
    .mode-sequencer {
        flex: 1;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1.5rem;
        min-width: 0;
    }
    .mode-sequencer button,
    .rotation-control {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-height: var(--touch-target);
        padding: 0.5rem 0;
        color: var(--ink);
        border: 0;
        background: transparent;
        cursor: pointer;
        font-size: 0.7rem;
        font-variation-settings:
            'wdth' 82,
            'wght' 550;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
    }
    .mode-sequencer button {
        border-bottom: 1px solid var(--rule);
        &[aria-pressed='true'] {
            color: var(--signal);
            border-color: currentColor;
            font-variation-settings:
                'wdth' 82,
                'wght' 760;
        }
        &:hover {
            color: var(--signal);
        }
        &:disabled {
            cursor: default;
        }
    }
    .rotation-control {
        color: var(--muted);
        min-width: 7.8rem;
        &[hidden] {
            display: none;
        }
        &:hover {
            color: var(--signal);
        }
        svg {
            width: 0.85rem;
            height: 0.85rem;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.5;
        }
        .play-symbol {
            display: none;
        }
        &[data-paused='true'] {
            .play-symbol {
                display: block;
            }
            .pause-symbol {
                display: none;
            }
        }
    }
    .mode-stage {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.38fr);
        align-items: end;
        gap: clamp(2rem, 4vw, 4rem);
        padding-block: 1rem;
        position: relative;
        z-index: 1;
    }
    .statement {
        --readout-gap: 1rem;
        min-width: 0;
        container-type: inline-size;
        display: grid;
        gap: 0.65rem;
        font-family: var(--font-display);
        font-weight: 400;
        letter-spacing: -0.035em;
        user-select: none;
    }
    .statement-line {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--readout-gap);
        height: max(min(16cqw, 9.5rem), calc(min(12.8cqw, 9rem) + 1.75rem));
        font-size: min(12.8cqw, 9rem);
        line-height: 1;
        white-space: nowrap;
    }
    .statement-word {
        display: block;
        flex-shrink: 0;
        text-box: trim-both cap alphabetic;
    }
    // The final word's descenders extend beneath the trimmed alphabetic baseline.
    .statement-word[data-word='3'] {
        margin-bottom: 0.2em;
    }
    .statement-ghost {
        user-select: none;
    }
    .statement-line:nth-child(1) .statement-word {
        font-variation-settings:
            'wdth' 58,
            'wght' 220;
    }
    .statement-line:nth-child(2) .statement-word {
        font-variation-settings:
            'wdth' 72,
            'wght' 760;
    }
    .statement-line:nth-child(3) .statement-word {
        font-style: italic;
        font-variation-settings:
            'wdth' 112,
            'wght' 360;
    }
    .statement-line:nth-child(4) .statement-word {
        font-variation-settings:
            'wdth' 112,
            'wght' 700;
    }
    .role-annotation {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        gap: 0.6rem;
        color: var(--muted);
        font-family: var(--font-body);
        font-size: 0.65rem;
        font-style: normal;
        font-variation-settings:
            'wdth' 82,
            'wght' 520;
        line-height: 1.3;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }
    .annotation-rule {
        width: 2.5rem;
        border-top: 1px solid var(--rule);
    }
    .line-marker {
        display: none;
    }
    .mode-notes {
        position: relative;
        z-index: 3;
        display: grid;
        padding-bottom: 0.2rem;
        // Reserve the tallest mode's space so automatic rotation never moves the footer.
        .mode-detail {
            grid-area: 1 / 1;
        }
        .mode-detail[hidden] {
            display: block;
            visibility: hidden;
            pointer-events: none;
        }
    }
    .mode-detail {
        h2 {
            max-width: 16ch;
            font-size: clamp(1.45rem, 2.25vw, 2.3rem);
            font-variation-settings:
                'wdth' 82,
                'wght' 620;
            letter-spacing: -0.025em;
            line-height: 1.08;
            text-wrap: balance;
        }
        > p:not(.mode-capabilities) {
            margin-top: 1rem;
            max-width: 32ch;
            font-size: 1rem;
            font-variation-settings:
                'wdth' 86,
                'wght' 390;
            line-height: 1.5;
        }
        .mode-capabilities {
            margin-top: 1.5rem;
            color: var(--muted);
            font-size: 0.7rem;
            font-variation-settings:
                'wdth' 86,
                'wght' 500;
            line-height: 1.5;
        }
        a {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.5rem;
            min-height: var(--touch-target);
            margin-top: 0.5rem;
            padding-block: 0.65rem;
            border-top: 1px solid var(--rule);
            color: var(--signal);
            font-size: 0.8rem;
            font-variation-settings:
                'wdth' 84,
                'wght' 530;
            line-height: 1.4;
            text-decoration: none;
            &:hover span {
                text-decoration: underline;
                text-underline-offset: 0.2em;
            }
            svg {
                width: 1rem;
                flex-shrink: 0;
                fill: none;
                stroke: currentColor;
                stroke-width: 1.5;
            }
        }
    }

    :global(.home[data-mode='backend']) {
        .statement {
            font-family: 'Fragment Mono', monospace;
            letter-spacing: -0.04em;
        }
        .statement-line {
            font-size: min(11.5cqw, 8rem);
            padding-left: 5cqw;
        }
        .statement-word {
            font-style: normal;
            text-transform: lowercase;
            font-weight: 400;
        }
        .statement-line:nth-child(even) .statement-word {
            color: var(--signal);
        }
        .line-marker {
            display: block;
            position: absolute;
            left: 0;
            top: 40%;
            font-size: 0.65rem;
            letter-spacing: 0;
            color: var(--muted);
        }
        .annotation-rule {
            width: 4rem;
            border-top-style: dashed;
        }
        .role-annotation {
            font-family: 'Fragment Mono', monospace;
            text-transform: lowercase;
        }
    }
    :global(.home[data-mode='qa']) {
        .statement-line {
            border-bottom: 1px solid var(--rule);
        }
        .statement-line:nth-child(n) .statement-word {
            font-style: normal;
            font-variation-settings:
                'wdth' 74,
                'wght' 520;
        }
        .role-annotation {
            background: var(--paper);
            padding-left: 0.65rem;
        }
        .annotation-rule {
            width: 0.55rem;
            height: 0.55rem;
            border: 1px solid var(--signal);
        }
        .statement-line::after {
            content: '';
            position: absolute;
            top: 16%;
            right: 0;
            width: 0.5rem;
            height: 0.5rem;
            border-top: 1px solid var(--signal);
            border-right: 1px solid var(--signal);
        }
        .statement-line:nth-child(3) .statement-word {
            color: var(--signal);
        }
    }
    :global(.home[data-mode='reliability']) {
        .statement-line {
            font-size: min(11.8cqw, 8.5rem);
        }
        .statement-line:nth-child(n) .statement-word {
            font-style: normal;
            font-variation-settings:
                'wdth' 86,
                'wght' 780;
        }
        .statement-line:nth-child(n + 3) .statement-word {
            color: var(--signal);
        }
        .annotation-rule {
            border-color: var(--signal);
            width: 4rem;
        }
        .role-annotation::after {
            content: '';
            width: 0.35rem;
            height: 0.35rem;
            border-radius: 50%;
            background: var(--signal);
        }
    }
    @media (min-width: 761px) {
        :global(.home[data-mode='qa']) {
            .statement-line {
                border-bottom: 0;
            }
            .role-annotation {
                position: relative;
                padding-left: 0;
                padding-right: 0.65rem;
                // Keep equal space around the readout, including the final word's descenders.
                &::after {
                    content: '';
                    position: absolute;
                    left: 0;
                    width: 100cqw;
                    top: calc(100% + var(--readout-gap));
                    border-top: 1px solid var(--rule);
                }
            }
        }
    }
    @media (min-width: 1201px) {
        .mode-stage {
            padding-block: 0;
        }
        .statement {
            // Reserve controls, footer, outer spacing, and four caption bands.
            // The lower bound keeps short windows readable and naturally scrollable.
            --hero-type-ceiling: clamp(3rem, calc((100svh - 29rem) / 4), 9rem);
            --hero-type-size: min(12.8cqw, var(--hero-type-ceiling));
        }
        .statement-line {
            height: calc(var(--hero-type-size) + 3rem);
            font-size: var(--hero-type-size);
        }
        :global(.home[data-mode='backend']) .statement-line {
            font-size: min(11.5cqw, 8rem, calc(var(--hero-type-ceiling) * 0.9));
        }
        :global(.home[data-mode='reliability']) .statement-line {
            font-size: min(
                11.8cqw,
                8.5rem,
                calc(var(--hero-type-ceiling) * 0.922)
            );
        }
    }
    @media (max-width: 1200px) {
        .mode-stage {
            grid-template-columns: minmax(0, 1fr);
            gap: 2rem;
        }
        .mode-notes {
            max-width: none;
        }
        .mode-detail {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0 2rem;
            &[hidden] {
                display: grid !important;
            }
            h2 {
                grid-column: 1;
            }
            > p:not(.mode-capabilities) {
                grid-column: 2;
                grid-row: 1 / 3;
                margin-top: 0;
            }
            .mode-capabilities {
                grid-column: 1;
                margin-top: 0.75rem;
            }
            a {
                grid-column: 2;
            }
        }
    }
    @media (max-width: 760px) {
        .mode-toolbar {
            display: grid;
            gap: 0;
        }
        .mode-sequencer {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.25rem 1rem;
        }
        .rotation-control {
            justify-self: end;
            min-height: var(--touch-target);
        }
        .mode-stage {
            padding-block: 0;
            gap: 1.75rem;
        }
        .statement {
            --readout-gap: 0.5rem;
            gap: 0.85rem;
        }
        .statement-line {
            height: max(17cqw, calc(12.8cqw + 1.25rem));
            font-size: 12.8cqw;
        }
        .role-annotation {
            align-self: flex-end;
            font-size: 0.55rem;
        }
        .annotation-rule {
