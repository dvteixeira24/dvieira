---
import { heroModes } from '../lib/hero-modes'
const initial = heroModes[0]
const words = ['Different', initial.noun, 'Same', 'approach.']
---

<div class="mode-toolbar">
    <div class="mode-sequencer" role="group" aria-label="Engineering modes">
        {
            heroModes.map((mode, index) => (
                <button
                    type="button"
                    data-role={mode.id}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                    aria-controls={`mode-detail-${mode.id}`}
                    disabled
                >
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    {mode.label}
                </button>
            ))
        }
    </div>
    <button class="rotation-control" type="button" hidden>
        <svg viewBox="0 0 16 16" aria-hidden="true">
            <path class="pause-symbol" d="M5 3v10M11 3v10"></path>
            <path class="play-symbol" d="m5 3 7 5-7 5Z"></path>
        </svg>
        <span>Pause cycle</span>
    </button>
</div>

<div class="mode-stage">
    <h1
        id="hero-title"
        class="statement"
        aria-label={`Different ${initial.noun} Same approach.`}
    >
        {
            words.map((word, index) => (
                <span class="statement-line" aria-hidden="true">
                    <span class="line-marker">
                        {String(index + 1).padStart(2, '0')}
                    </span>
                    <span class="statement-word" data-word={index}>
                        {word}
                    </span>
                    <span class="role-annotation">
                        <span class="annotation-rule" />
                        <span data-cue={index}>{initial.cues[index]}</span>
                    </span>
                </span>
            ))
        }
    </h1>
    <div class="mode-notes">
        {
            heroModes.map((mode, index) => (
                <section
                    id={`mode-detail-${mode.id}`}
                    class="mode-detail"
                    aria-labelledby={`mode-title-${mode.id}`}
                    hidden={index !== 0}
                >
                    <h2 id={`mode-title-${mode.id}`}>{mode.title}</h2>
                    <p>{mode.description}</p>
                    <p class="mode-capabilities">{mode.detail}</p>
                    <a href={mode.href}>
                        <span>{mode.evidence}</span>
                        <svg viewBox="0 0 20 20" aria-hidden="true">
                            <path d="M4 16 16 4M4 4h12v12" />
                        </svg>
                    </a>
                </section>
            ))
        }
    </div>
</div>

<script>
    import { heroModes } from '../lib/hero-modes'

    let disposeModes: (() => void) | undefined

    function initModes(): void {
        disposeModes?.()
        const home = document.querySelector<HTMLElement>('.home')
        const hero = home?.querySelector<HTMLElement>('.hero')
        const controls =
            home?.querySelectorAll<HTMLButtonElement>('[data-role]')
        const rotation =
            home?.querySelector<HTMLButtonElement>('.rotation-control')
        const heading = home?.querySelector<HTMLElement>('#hero-title')
        if (!home || !hero || !controls || !rotation || !heading) return

        // Warm the alternate face before its first automatic appearance.
        void document.fonts.load('1em "Fragment Mono"').catch(() => {})
        const listeners = new AbortController()
        const options = { signal: listeners.signal }
        const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)')
        let current = 0
        let paused = reducedMotion.matches
        let visible = false
        let hovering = hero.matches(':hover')
        let timer: number | undefined

        function stopTimer(): void {
            window.clearInterval(timer)
            timer = undefined
        }

        function updatePlayback(): void {
            stopTimer()
            rotation!.dataset.paused = String(paused)
            rotation!.querySelector('span')!.textContent = paused
                ? 'Resume cycle'
                : 'Pause cycle'
            if (paused || !visible || hovering || document.hidden) return
            timer = window.setInterval(
                () => selectMode((current + 1) % heroModes.length),
                5000,
            )
        }

        function selectMode(index: number): void {
            current = index
            const mode = heroModes[index]
            home!.dataset.mode = mode.id
            heading!.setAttribute(
                'aria-label',
                `Different ${mode.noun} Same approach.`,
            )
            heading!.querySelector('[data-word="1"]')!.textContent = mode.noun
            heading!
                .querySelectorAll<HTMLElement>('[data-cue]')
                .forEach((cue, i) => {
                    cue.textContent = mode.cues[i]
                })
            controls!.forEach((button, i) =>
                button.setAttribute('aria-pressed', String(i === index)),
            )
            home!
                .querySelectorAll<HTMLElement>('.mode-detail')
                .forEach((panel, i) => {
                    panel.hidden = i !== index
                })
        }

        controls.forEach((control, index) => {
            control.disabled = false
            control.addEventListener(
                'click',
                () => {
                    paused = true
                    selectMode(index)
                    updatePlayback()
                },
                options,
            )
        })
        rotation.hidden = false
        rotation.addEventListener(
            'click',
            () => {
                paused = !paused
                updatePlayback()
            },
            options,
        )
        hero.addEventListener(
            'focusin',
            event => {
                // Focusing the playback control must not change its action before click.
                if (
                    event.target === rotation &&
                    !rotation.matches(':focus-visible')
                )
                    return
                paused = true
                updatePlayback()
            },
            options,
        )
        hero.addEventListener(
            'pointerenter',
            event => {
                if (event.pointerType !== 'mouse') return
                hovering = true
                updatePlayback()
            },
            options,
        )
        hero.addEventListener(
            'pointerleave',
            event => {
                if (event.pointerType !== 'mouse') return
                hovering = false
                updatePlayback()
            },
            options,
        )
        document.addEventListener('visibilitychange', updatePlayback, options)
        reducedMotion.addEventListener(
            'change',
            () => {
                if (reducedMotion.matches) paused = true
                updatePlayback()
            },
            options,
        )
        const observer = new IntersectionObserver(entries => {
            visible = entries[0].isIntersecting
            updatePlayback()
        })
        observer.observe(hero)
        selectMode(0)
        updatePlayback()
        disposeModes = () => {
            stopTimer()
            observer.disconnect()
            listeners.abort()
        }
    }

    document.addEventListener('astro:page-load', initModes)
    document.addEventListener('astro:before-swap', () => disposeModes?.())
</script>

<style lang="scss">
    @font-face {
        font-family: 'Fragment Mono';
        src: url('/font/FragmentMono-Regular.ttf') format('truetype');
        font-style: normal;
        font-weight: 400;
        font-display: swap;
    }

    .mode-toolbar {
        display: flex;
        align-items: start;
        gap: clamp(1rem, 4vw, 4rem);
        position: relative;
        z-index: 3;
    }
    .mode-sequencer {
        flex: 1;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1.5rem;
        min-width: 0;
    }
    .mode-sequencer button,
    .rotation-control {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-height: var(--touch-target);
        padding: 0.5rem 0;
        color: var(--ink);
        border: 0;
        background: transparent;
        cursor: pointer;
        font-size: 0.7rem;
        font-variation-settings:
            'wdth' 82,
            'wght' 550;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
    }
    .mode-sequencer button {
        border-bottom: 1px solid var(--rule);
        &[aria-pressed='true'] {
            color: var(--signal);
            border-color: currentColor;
            font-variation-settings:
                'wdth' 82,
                'wght' 760;
        }
        &:hover {
            color: var(--signal);
        }
        &:disabled {
            cursor: default;
        }
    }
    .rotation-control {
        color: var(--muted);
        min-width: 7.8rem;
        &[hidden] {
            display: none;
        }
        &:hover {
            color: var(--signal);
        }
        svg {
            width: 0.85rem;
            height: 0.85rem;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.5;
        }
        .play-symbol {
            display: none;
        }
        &[data-paused='true'] {
            .play-symbol {
                display: block;
            }
            .pause-symbol {
                display: none;
            }
        }
    }
    .mode-stage {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.38fr);
        align-items: end;
        gap: clamp(2rem, 4vw, 4rem);
        padding-block: 1rem;
        position: relative;
        z-index: 1;
    }
    .statement {
        min-width: 0;
        container-type: inline-size;
        display: grid;
        gap: 0.65rem;
        font-family: var(--font-display);
        font-weight: 400;
        letter-spacing: -0.035em;
        user-select: none;
    }
    .statement-line {
        position: relative;
        display: flex;
        align-items: center;
        height: min(16cqw, 9.5rem);
        padding-bottom: 1.1rem;
        font-size: min(12.8cqw, 9rem);
        line-height: 1;
        white-space: nowrap;
    }
    .statement-word {
        display: inline-block;
        transition:
            font-variation-settings 650ms var(--ease-out),
            color 300ms ease;
    }
    .statement-line:nth-child(1) .statement-word {
        font-variation-settings:
            'wdth' 58,
            'wght' 220;
    }
    .statement-line:nth-child(2) .statement-word {
        font-variation-settings:
            'wdth' 72,
            'wght' 760;
    }
    .statement-line:nth-child(3) .statement-word {
        font-style: italic;
        font-variation-settings:
            'wdth' 112,
            'wght' 360;
    }
    .statement-line:nth-child(4) .statement-word {
        font-variation-settings:
            'wdth' 112,
            'wght' 700;
    }
    .role-annotation {
        position: absolute;
        bottom: 0;
        right: 0;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--muted);
        font-family: var(--font-body);
        font-size: 0.65rem;
        font-style: normal;
        font-variation-settings:
            'wdth' 82,
            'wght' 520;
        line-height: 1.3;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }
    .annotation-rule {
        width: 2.5rem;
        border-top: 1px solid var(--rule);
    }
    .line-marker {
        display: none;
    }
    .mode-notes {
        position: relative;
        z-index: 3;
        display: grid;
        padding-bottom: 0.2rem;
        // Reserve the tallest mode's space so automatic rotation never moves the footer.
        .mode-detail {
            grid-area: 1 / 1;
        }
        .mode-detail[hidden] {
            display: block;
            visibility: hidden;
            pointer-events: none;
        }
    }
    .mode-detail {
        h2 {
            max-width: 16ch;
            font-size: clamp(1.45rem, 2.25vw, 2.3rem);
            font-variation-settings:
                'wdth' 82,
                'wght' 620;
            letter-spacing: -0.025em;
            line-height: 1.08;
            text-wrap: balance;
        }
        > p:not(.mode-capabilities) {
            margin-top: 1rem;
            max-width: 32ch;
            font-size: 1rem;
            font-variation-settings:
                'wdth' 86,
                'wght' 390;
            line-height: 1.5;
        }
        .mode-capabilities {
            margin-top: 1.5rem;
            color: var(--muted);
            font-size: 0.7rem;
            font-variation-settings:
                'wdth' 86,
                'wght' 500;
            line-height: 1.5;
        }
        a {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.5rem;
            min-height: var(--touch-target);
            margin-top: 0.5rem;
            padding-block: 0.65rem;
            border-top: 1px solid var(--rule);
            color: var(--signal);
            font-size: 0.8rem;
            font-variation-settings:
                'wdth' 84,
                'wght' 530;
            line-height: 1.4;
            text-decoration: none;
            &:hover span {
                text-decoration: underline;
                text-underline-offset: 0.2em;
            }
            svg {
                width: 1rem;
                flex-shrink: 0;
                fill: none;
                stroke: currentColor;
                stroke-width: 1.5;
            }
        }
    }

    :global(.home[data-mode='backend']) {
        .statement {
            font-family: 'Fragment Mono', monospace;
            letter-spacing: -0.04em;
        }
        .statement-line {
            font-size: min(11.5cqw, 8rem);
            padding-left: 5cqw;
        }
        .statement-word {
            font-style: normal;
            text-transform: lowercase;
            font-weight: 400;
        }
        .statement-line:nth-child(even) .statement-word {
            color: var(--signal);
        }
        .line-marker {
            display: block;
            position: absolute;
            left: 0;
            top: 40%;
            font-size: 0.65rem;
            letter-spacing: 0;
            color: var(--muted);
        }
        .annotation-rule {
            width: 4rem;
            border-top-style: dashed;
        }
        .role-annotation {
            font-family: 'Fragment Mono', monospace;
            text-transform: lowercase;
        }
    }
    :global(.home[data-mode='qa']) {
        .statement-line {
            border-bottom: 1px solid var(--rule);
        }
        .statement-line:nth-child(n) .statement-word {
            font-style: normal;
            font-variation-settings:
                'wdth' 74,
                'wght' 520;
        }
        .role-annotation {
            background: var(--paper);
            padding-left: 0.65rem;
            bottom: -0.35rem;
        }
        .annotation-rule {
            width: 0.55rem;
            height: 0.55rem;
            border: 1px solid var(--signal);
        }
        .statement-line::after {
            content: '';
            position: absolute;
            top: 16%;
            right: 0;
            width: 0.5rem;
            height: 0.5rem;
            border-top: 1px solid var(--signal);
            border-right: 1px solid var(--signal);
        }
        .statement-line:nth-child(3) .statement-word {
            color: var(--signal);
        }
    }
    :global(.home[data-mode='reliability']) {
        .statement-line {
            font-size: min(11.8cqw, 8.5rem);
        }
        .statement-line:nth-child(n) .statement-word {
            font-style: normal;
            font-variation-settings:
                'wdth' 86,
                'wght' 780;
        }
        .statement-line:nth-child(n + 3) .statement-word {
            color: var(--signal);
        }
        .annotation-rule {
            border-color: var(--signal);
            width: 4rem;
        }
        .role-annotation::after {
            content: '';
            width: 0.35rem;
            height: 0.35rem;
            border-radius: 50%;
            background: var(--signal);
        }
    }
    @media (min-width: 761px) {
        // Read as captions for the type, outside the moving graphic's field.
        .role-annotation {
            left: 0;
            right: auto;
        }
        :global(.home[data-mode='backend']) .role-annotation {
            left: 5cqw;
        }
        :global(.home[data-mode='qa']) .role-annotation {
            padding-left: 0;
            padding-right: 0.65rem;
        }
    }
    @media (max-width: 1200px) {
        .mode-stage {
            grid-template-columns: minmax(0, 1fr);
            gap: 2rem;
        }
        .mode-notes {
            max-width: none;
        }
        .mode-detail {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0 2rem;
            &[hidden] {
                display: grid !important;
            }
            h2 {
                grid-column: 1;
            }
            > p:not(.mode-capabilities) {
                grid-column: 2;
                grid-row: 1 / 3;
                margin-top: 0;
            }
            .mode-capabilities {
                grid-column: 1;
                margin-top: 0.75rem;
            }
            a {
                grid-column: 2;
            }
        }
    }
    @media (max-width: 760px) {
        .mode-toolbar {
            display: grid;
            gap: 0;
        }
        .mode-sequencer {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.25rem 1rem;
        }
        .rotation-control {
            justify-self: end;
            min-height: var(--touch-target);
        }
        .mode-stage {
            padding-block: 0;
            gap: 1.75rem;
        }
        .statement {
            gap: 0.85rem;
        }
        .statement-line {
            height: 17cqw;
            font-size: 12.8cqw;
        }
        .role-annotation {
            font-size: 0.55rem;
        }
        .annotation-rule {
            width: 1.5rem;
        }
        .mode-detail {
            display: block;
            &[hidden] {
                display: block !important;
            }
            h2 {
                max-width: 23ch;
                font-size: 1.45rem;
            }
            > p:not(.mode-capabilities) {
                margin-top: 0.6rem;
                max-width: 40ch;
                font-size: 0.95rem;
            }
            .mode-capabilities {
                margin-top: 1rem;
            }
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .statement-word {
            transition: none;
        }
    }
</style>
