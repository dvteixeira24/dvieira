<div class="role-loom" aria-hidden="true"><canvas></canvas></div>

<script>
    const ROLE_INDEX = {
        frontend: 0,
        backend: 1,
        qa: 2,
        reliability: 3,
    } as const
    type Role = keyof typeof ROLE_INDEX
    let disposeRoleLoom: (() => void) | undefined

    function initRoleLoom(): void {
        disposeRoleLoom?.()
        const home = document.querySelector<HTMLElement>('.home')
        const loom = home?.querySelector<HTMLElement>('.role-loom')
        const canvas = loom?.querySelector('canvas')
        if (!home || !loom || !canvas) return
        const gl = canvas.getContext('webgl', {
            alpha: true,
            antialias: true,
            powerPreference: 'low-power',
        })
        if (!gl) {
            loom.dataset.unavailable = 'true'
            return
        }

        const vertexSource = `
            precision highp float;
            attribute vec2 point;
            attribute float side;
            uniform vec2 viewport;
            uniform float pixelRatio;
            varying float edge;
            uniform float fromRole;
            uniform float toRole;
            uniform float blend;
            uniform float time;
            uniform float aspect;
            varying float depth;
            const float PI = 3.14159265;
            vec3 shape(float role, vec2 p) {
                float angle = p.x * 2.0 * PI;
                float row = p.y * 2.0 - 1.0;
                if (role < 0.5) {
                    float x = (p.x * 2.0 - 1.0) * 1.48;
                    float wave = x * 2.8 - time * 1.15 + row * 1.7;
                    float crossWave = x * 1.6 + row * 3.4 + time * 0.8;
                    return vec3(
                        x + 0.07 * sin(crossWave),
                        row * 0.78 + 0.2 * sin(wave) + 0.06 * cos(crossWave),
                        0.34 * cos(wave) + 0.12 * sin(crossWave)
                    );
                }
                if (role < 1.5) {
                    float orbit = angle + time * 0.22;
                    float braid = angle * 3.0 + row * PI - time * 1.25;
                    float radius = 0.91 + 0.25 * cos(braid);
                    return vec3(
                        radius * cos(orbit),
                        radius * sin(orbit) * 0.72,
                        0.4 * sin(braid) + row * 0.14
                    );
                }
                if (role < 2.5) {
                    float latitude = row * PI * 0.47;
                    float stress = (
                        0.14 * sin(angle * 4.0 - time * 1.6 + latitude * 3.0)
                        + 0.06 * cos(angle * 7.0 + time * 0.95 - latitude * 2.0)
                    ) * pow(max(0.0, cos(latitude)), 2.0);
                    float radius = 0.98 + stress;
                    float orbit = angle + time * 0.18;
                    return vec3(radius * cos(orbit) * cos(latitude), radius * sin(latitude), radius * sin(orbit) * cos(latitude));
                }
                float orbit = angle + time * 0.28;
                float ripple = angle * 3.0 - time * 1.3;
                float tube = row * PI + 0.36 * sin(ripple);
                float radius = 0.84 + 0.25 * cos(tube) + 0.07 * sin(ripple);
                return vec3(
                    radius * cos(orbit),
                    radius * sin(orbit),
                    0.3 * sin(tube) + 0.13 * cos(angle * 2.0 + time * 0.85)
                );
            }
            vec3 project(vec2 p) {
                vec3 position = mix(shape(fromRole, p), shape(toRole, p), blend);
                float turn = 0.24 + sin(time * 0.42) * 0.48;
                position.xz = mat2(cos(turn), -sin(turn), sin(turn), cos(turn)) * position.xz;
                float tilt = 0.57 + sin(time * 0.34) * 0.24;
                position.yz = mat2(cos(tilt), -sin(tilt), sin(tilt), cos(tilt)) * position.yz;
                float roll = sin(time * 0.27) * 0.14;
                position.xy = mat2(cos(roll), -sin(roll), sin(roll), cos(roll)) * position.xy;
                float perspective = 3.7 / (3.7 - position.z);
                float scale = min(1.05, aspect / 1.8);
                return vec3(position.x * perspective * scale / aspect, position.y * perspective * scale, position.z);
            }
            void main() {
                vec3 position = project(point);
                vec2 tangent = (project(point + vec2(0.001, 0.0)).xy - project(point - vec2(0.001, 0.0)).xy) * viewport;
                vec2 normal = vec2(-tangent.y, tangent.x) / max(length(tangent), 0.0001);
                depth = clamp((position.z + 1.2) / 2.4, 0.0, 1.0);
                float width = mix(0.75, 1.65, depth) * pixelRatio;
                gl_Position = vec4(position.xy + normal * side * width / viewport, 0.0, 1.0);
                edge = side;
            }
        `
        const fragmentSource = `
            precision mediump float;
            varying float depth;
            varying float edge;
            void main() {
                float coverage = 1.0 - smoothstep(0.65, 1.0, abs(edge));
                gl_FragColor = vec4(0.58, 0.63, 0.72, coverage * mix(0.28, 0.46, depth));
            }
        `
        const compileShader = (type: number, source: string): WebGLShader => {
            const shader = gl.createShader(type)
            if (!shader) throw new Error('Unable to create loom shader')
            gl.shaderSource(shader, source)
            gl.compileShader(shader)
            if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
                const message = gl.getShaderInfoLog(shader)
                gl.deleteShader(shader)
                throw new Error(message ?? 'Unable to compile loom shader')
            }
            return shader
        }

        let program: WebGLProgram
        let vertexShader: WebGLShader
        let fragmentShader: WebGLShader
        try {
            vertexShader = compileShader(gl.VERTEX_SHADER, vertexSource)
            fragmentShader = compileShader(gl.FRAGMENT_SHADER, fragmentSource)
            const nextProgram = gl.createProgram()
            if (!nextProgram) throw new Error('Unable to create loom program')
            program = nextProgram
            gl.attachShader(program, vertexShader)
            gl.attachShader(program, fragmentShader)
            gl.linkProgram(program)
            if (!gl.getProgramParameter(program, gl.LINK_STATUS))
                throw new Error(
                    gl.getProgramInfoLog(program) ??
                        'Unable to link loom program',
                )
        } catch {
            loom.dataset.unavailable = 'true'
            return
        }

        gl.useProgram(program)
        const smallScreen = window.matchMedia('(max-width: 760px)')
        const pointsPerLine = 129
        const lineCount = 33
        const points: number[] = []
        // Triangle ribbons avoid the one-pixel line-width limit on many WebGL drivers.
        for (let row = 0; row < lineCount; row += 1) {
            for (let column = 0; column < pointsPerLine - 1; column += 1) {
                const x = column / (pointsPerLine - 1)
                const next = (column + 1) / (pointsPerLine - 1)
                const y = row / (lineCount - 1)
                points.push(x, y, -1, next, y, -1, x, y, 1)
                points.push(x, y, 1, next, y, -1, next, y, 1)
            }
        }
        const buffer = gl.createBuffer()
        if (!buffer) return
        gl.bindBuffer(gl.ARRAY_BUFFER, buffer)
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(points), gl.STATIC_DRAW)
        const pointAttribute = gl.getAttribLocation(program, 'point')
        gl.enableVertexAttribArray(pointAttribute)
        gl.vertexAttribPointer(pointAttribute, 2, gl.FLOAT, false, 12, 0)
        const sideAttribute = gl.getAttribLocation(program, 'side')
        gl.enableVertexAttribArray(sideAttribute)
        gl.vertexAttribPointer(sideAttribute, 1, gl.FLOAT, false, 12, 8)
        const uniform = (name: string): WebGLUniformLocation | null =>
            gl.getUniformLocation(program, name)
        const uniforms = {
            fromRole: uniform('fromRole'),
            toRole: uniform('toRole'),
            blend: uniform('blend'),
            time: uniform('time'),
            aspect: uniform('aspect'),
            viewport: uniform('viewport'),
            pixelRatio: uniform('pixelRatio'),
        }
        const reducedMotion = window.matchMedia(
            '(prefers-reduced-motion: reduce)',
        )
        let fromRole = ROLE_INDEX[home.dataset.mode as Role] ?? 0
        let toRole = fromRole
        let transitionStarted = performance.now() - 1200
        let previousFrame = performance.now()
        let motionTime = 0
        let visible = true
        let animationFrame = 0
        let disposed = false
        let pixelRatio = 1

        const resize = (): void => {
            const bounds = canvas.getBoundingClientRect()
            pixelRatio = Math.min(window.devicePixelRatio || 1, 1.5)
            const width = Math.max(1, Math.round(bounds.width * pixelRatio))
            const height = Math.max(1, Math.round(bounds.height * pixelRatio))
            if (canvas.width === width && canvas.height === height) return
            canvas.width = width
            canvas.height = height
            gl.viewport(0, 0, width, height)
        }
        const selectRole = (role: Role): void => {
            const nextRole = ROLE_INDEX[role]
            if (nextRole === toRole) return
            fromRole = toRole
            toRole = nextRole
            transitionStarted = performance.now()
            wake()
        }
        const modeObserver = new MutationObserver(() => {
            const role = home.dataset.mode as Role
            if (role in ROLE_INDEX) selectRole(role)
        })
        modeObserver.observe(home, {
            attributes: true,
            attributeFilter: ['data-mode'],
        })
        const resizeObserver = new ResizeObserver(() => {
            resize()
            wake()
        })
        resizeObserver.observe(loom)
        const visibilityObserver = new IntersectionObserver(entries => {
            visible = entries[0]?.isIntersecting ?? false
            wake()
        })
        visibilityObserver.observe(loom)

        const render = (now: number): void => {
            animationFrame = 0
            if (disposed || !visible || document.hidden) return
            const delta = Math.min(now - previousFrame, 80)
            previousFrame = now
            if (visible && !document.hidden) {
                resize()
                if (!reducedMotion.matches) motionTime += delta * 0.001
                const progress = reducedMotion.matches
                    ? 1
                    : Math.min(1, (now - transitionStarted) / 1200)
                const eased = progress * progress * (3 - 2 * progress)
                gl.clearColor(0, 0, 0, 0)
                gl.clear(gl.COLOR_BUFFER_BIT)
                gl.uniform1f(uniforms.fromRole, fromRole)
                gl.uniform1f(uniforms.toRole, toRole)
                gl.uniform1f(uniforms.blend, eased)
                gl.uniform1f(uniforms.time, motionTime)
                gl.uniform1f(uniforms.aspect, canvas.width / canvas.height)
                gl.uniform2f(uniforms.viewport, canvas.width, canvas.height)
                gl.uniform1f(uniforms.pixelRatio, pixelRatio)
                const verticesPerLine = (pointsPerLine - 1) * 6
                if (smallScreen.matches) {
                    for (let row = 0; row < lineCount; row += 2)
                        gl.drawArrays(
                            gl.TRIANGLES,
                            row * verticesPerLine,
                            verticesPerLine,
                        )
                } else {
                    gl.drawArrays(gl.TRIANGLES, 0, points.length / 3)
                }
                if (!reducedMotion.matches)
                    animationFrame = window.requestAnimationFrame(render)
            }
        }
        function wake(): void {
            if (disposed) return
            const active = visible && !document.hidden
            home!.dataset.heroAmbient = active ? 'running' : 'paused'
            if (!active) {
                window.cancelAnimationFrame(animationFrame)
                animationFrame = 0
            } else if (!animationFrame) {
                previousFrame = performance.now()
                animationFrame = window.requestAnimationFrame(render)
            }
        }
        const loseContext = (event: Event): void => {
            event.preventDefault()
            disposeRoleLoom?.()
            loom.dataset.unavailable = 'true'
        }
        const restoreContext = (): void => {
            if (!canvas.isConnected) return
            delete loom.dataset.unavailable
            initRoleLoom()
        }
        document.addEventListener('visibilitychange', wake)
        reducedMotion.addEventListener('change', wake)
        smallScreen.addEventListener('change', wake)
        canvas.addEventListener('webglcontextlost', loseContext)
        canvas.addEventListener('webglcontextrestored', restoreContext, {
            once: true,
        })

        resize()
        gl.enable(gl.BLEND)
        gl.blendFuncSeparate(
            gl.SRC_ALPHA,
            gl.ONE_MINUS_SRC_ALPHA,
            gl.ONE,
            gl.ONE_MINUS_SRC_ALPHA,
        )
        wake()
        disposeRoleLoom = () => {
            disposed = true
            home.dataset.heroAmbient = 'paused'
            window.cancelAnimationFrame(animationFrame)
            document.removeEventListener('visibilitychange', wake)
            reducedMotion.removeEventListener('change', wake)
            smallScreen.removeEventListener('change', wake)
            canvas.removeEventListener('webglcontextlost', loseContext)
            // Keep the one-shot restoration listener only while this canvas is connected.
            if (!gl.isContextLost())
                canvas.removeEventListener(
                    'webglcontextrestored',
                    restoreContext,
                )
            modeObserver.disconnect()
            resizeObserver.disconnect()
            visibilityObserver.disconnect()
            gl.deleteBuffer(buffer)
            gl.deleteProgram(program)
            gl.deleteShader(vertexShader)
            gl.deleteShader(fragmentShader)
            disposeRoleLoom = undefined
        }
    }

    document.addEventListener('astro:page-load', initRoleLoom)
    const cleanupRoleLoom = (): void => disposeRoleLoom?.()
    document.addEventListener('astro:before-swap', cleanupRoleLoom)
    if (import.meta.hot) {
        import.meta.hot.dispose(() => {
            disposeRoleLoom?.()
            document.removeEventListener('astro:page-load', initRoleLoom)
            document.removeEventListener('astro:before-swap', cleanupRoleLoom)
        })
    }
</script>

<style lang="scss">
    .role-loom {
        position: absolute;
        z-index: 2;
        top: 4.8rem;
        right: -12%;
        width: min(72rem, 82%);
        height: min(44rem, 72%);
        overflow: hidden;
        opacity: 0.72;
        mix-blend-mode: normal;
        pointer-events: none;
        mask-image: linear-gradient(
            90deg,
            transparent 0%,
            black 24%,
            black 88%,
            transparent 100%
        );
        &[data-unavailable='true'] {
            display: none;
        }
    }
    canvas {
        display: block;
        width: 100%;
        height: 100%;
    }
    @media (max-width: 760px) {
        .role-loom {
            top: 7.5rem;
            right: -36%;
            width: 118%;
            height: 28rem;
            opacity: 0.58;
        }
    }
</style>
