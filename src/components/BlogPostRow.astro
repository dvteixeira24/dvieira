---
import { formatDate } from '../lib/blog'

interface Props {
    href: string
    title: string
    description: string
    pubDate: Date
    tags?: string[]
}

const { href, title, description, pubDate, tags } = Astro.props
---

<li class="blog-row">
    <time class="blog-row-date" datetime={pubDate.toISOString()}>
        {formatDate(pubDate)}
    </time>
    <article class="blog-row-body">
        <h2 class="blog-row-title">
            <a href={href}>{title}</a>
        </h2>
        <p class="blog-row-desc">{description}</p>
        {tags && tags.length > 0 && (
            <ul class="tags" aria-label="Topics">
                {tags.map(tag => <li>{tag}</li>)}
            </ul>
        )}
    </article>
</li>

<style lang="scss">
    .blog-row {
        display: grid;
        grid-template-columns: clamp(8rem, 14vw, 12rem) minmax(0, 1fr);
        gap: clamp(1.5rem, 4vw, 3.5rem);
        padding: clamp(1.75rem, 3vw, 2.5rem) 0;
        border-bottom: 1px solid var(--rule);
        transition: background-color 220ms var(--ease-out);
    }

    .blog-row:first-child {
        border-top: 1px solid var(--ink);
    }

    .blog-row:last-child {
        border-bottom: 1px solid var(--ink);
    }

    .blog-row:hover {
        background: var(--heritage-cream);
    }

    .blog-row-date {
        padding-top: 0.5rem;
        color: var(--muted);
        font-size: 0.8rem;
        font-variation-settings:
            'wdth' 85,
            'wght' 560;
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        line-height: 1.5;
    }

    .blog-row-body {
        max-width: 70ch;
    }

    .blog-row-title {
        font-family: var(--font-human);
        font-size: clamp(1.75rem, 3.1vw, 2.75rem);
        font-weight: 650;
        letter-spacing: -0.025em;
        line-height: 1.05;
        text-wrap: balance;
    }

    .blog-row-title a {
        color: var(--ink);
        text-decoration: none;
        transition: color 220ms var(--ease-out);
    }

    .blog-row-title a:hover,
    .blog-row-title a:focus-visible {
        color: var(--signal);
        text-decoration: underline;
        text-underline-offset: 0.22em;
    }

    .blog-row-desc {
        margin-top: 0.9rem;
        color: var(--muted);
        font-size: clamp(1rem, 1.25vw, 1.15rem);
        font-variation-settings:
            'wdth' 88,
            'wght' 380;
        line-height: 1.55;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1.1rem;
        padding: 0;
        list-style: none;
    }

    .tags li {
        padding: 0.4rem 0.6rem;
        border: 1px solid var(--rule);
        background: var(--paper);
        font-size: 0.75rem;
        font-variation-settings:
            'wdth' 85,
            'wght' 460;
        letter-spacing: 0.02em;
        line-height: 1.3;
    }

    @media (max-width: 760px) {
        .blog-row {
            grid-template-columns: minmax(0, 1fr);
            gap: 0.6rem;
            padding: 1.75rem 0;
        }

        .blog-row-date {
            padding-top: 0;
        }
    }
</style>
