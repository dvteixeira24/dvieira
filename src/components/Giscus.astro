---
import { giscus, giscusConfigured } from '../lib/giscus'

const { repo, repoId, category, categoryId } = giscus
---

{
    giscusConfigured ? (
        <div class="giscus">
            <script
                is:inline
                data-astro-rerun
                define:vars={{ repo, repoId, category, categoryId }}>
                ;(() => {
                    const host = document.currentScript.parentElement
                    if (!host) return
                    // Remove any prior giscus iframe so pathname re-maps on
                    // client-side navigation between posts.
                    host.querySelectorAll('iframe.giscus-frame').forEach(
                        frame => frame.remove(),
                    )
                    const script = document.createElement('script')
                    script.src = 'https://giscus.app/client.js'
                    script.async = true
                    script.crossOrigin = 'anonymous'
                    script.setAttribute('data-repo', repo)
                    script.setAttribute('data-repo-id', repoId)
                    script.setAttribute('data-category', category)
                    script.setAttribute('data-category-id', categoryId)
                    script.setAttribute('data-mapping', 'pathname')
                    script.setAttribute('data-strict', '0')
                    script.setAttribute('data-reactions-enabled', '1')
                    script.setAttribute('data-emit-metadata', '0')
                    script.setAttribute('data-input-position', 'bottom')
                    script.setAttribute('data-theme', 'light')
                    script.setAttribute('data-lang', 'en')
                    host.appendChild(script)
                })()
            </script>
        </div>
    ) : (
        <p class="giscus-unavailable">Comments are unavailable.</p>
    )
}

<style lang="scss">
    .giscus {
        margin-top: clamp(2.5rem, 5vw, 4rem);
        padding-top: 2rem;
        border-top: 1px solid var(--rule);
    }

    .giscus-unavailable {
        margin-top: clamp(2.5rem, 5vw, 4rem);
        padding-top: 1.5rem;
        border-top: 1px solid var(--rule);
        color: var(--muted);
        font-size: 0.85rem;
        font-variation-settings:
            'wdth' 85,
            'wght' 460;
        line-height: 1.5;
    }
</style>
