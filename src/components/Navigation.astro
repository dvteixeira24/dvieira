---
const currentPath =
    Astro.url.pathname.replace(/\/+$/, '').replace(/\.html$/, '') || '/'
const links = [
    { href: '/', label: 'Home' },
    { href: '/about', label: 'About' },
    { href: '/blog', label: 'Blog' },
    { href: '/contact', label: 'Contact' },
]
---

<header class="site-rail">
    <nav aria-label="Primary navigation">
        {
            links.map(link => (
                <a
                    href={link.href}
                    aria-current={
                        currentPath === link.href ? 'page' : undefined
                    }
                >
                    {link.label}
                </a>
            ))
        }
    </nav>
</header>

<style lang="scss">
    .site-rail {
        position: fixed;
        z-index: 30;
        inset: 0 auto 0 0;
        width: var(--rail-width);
        padding: clamp(1rem, 2vw, 1.45rem) 1.1rem;
        border-right: 1px solid var(--ink);
        background: var(--heritage-cream);
    }

    nav {
        position: absolute;
        top: 50%;
        left: 50%;
        display: flex;
        justify-content: flex-start;
        gap: clamp(1.3rem, 4vh, 2.5rem);
        transform: translate(-50%, -50%);
        writing-mode: vertical-rl;
    }

    nav a {
        position: relative;
        min-width: var(--touch-target);
        min-height: var(--touch-target);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 24px 4px;
        color: var(--ink);
        font-family: var(--font-human);
        font-size: 0.9rem;
        font-weight: 610;
        text-decoration: none;
        transition:
            color 220ms var(--ease-out),
            background-color 220ms var(--ease-out),
            transform 220ms var(--ease-out),
            box-shadow 220ms var(--ease-out);

        &::after {
            position: absolute;
            inset: auto -0.24rem -0.1rem auto;
            width: 0.34rem;
            aspect-ratio: 1;
            content: '';
            border-radius: 50%;
            background: var(--signal);
            opacity: 0;
            transform: scale(0);
            transition:
                opacity 220ms var(--ease-out),
                transform 220ms var(--ease-out);
        }

        &:hover,
        &[aria-current='page'] {
            color: var(--ink);
            background: var(--heritage-amber);
            box-shadow: 2px 2px 0 var(--ink);
            transform: translate(-1px, -1px);
        }

        &[aria-current='page']::after {
            opacity: 1;
            transform: scale(2);
            outline: 1px white solid;
        }
    }

    @media (max-width: 760px) {
        .site-rail {
            display: contents;
        }

        nav {
            position: fixed;
            z-index: 31;
            top: auto;
            right: auto;
            bottom: calc(0.8rem + env(safe-area-inset-bottom));
            left: 50%;
            width: max-content;
            max-width: calc(100vw - 1.5rem);
            display: flex;
            flex-direction: row;
            justify-content: center;
            gap: 0.15rem;
            padding: 0.48rem;
            background: var(--heritage-amber);
            box-shadow: 3px 3px 0 var(--ink);
            transform: translateX(-50%);
            writing-mode: horizontal-tb;
        }

        nav a {
            padding: 0.4rem clamp(0.42rem, 2.1vw, 0.7rem);
            font-size: clamp(0.74rem, 3vw, 0.86rem);
            white-space: nowrap;
        }

        nav a:hover,
        nav a[aria-current='page'] {
            background: var(--heritage-cream);
            box-shadow: none;
            transform: none;
        }

        nav a::after {
            display: none;
        }
    }
</style>
