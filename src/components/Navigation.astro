---
import profileImage from '../assets/profiled.jpg'

const currentPath = Astro.url.pathname
const links = [
    { href: '/', label: 'Home' },
    { href: '/biography', label: 'Biography' },
    { href: '/experience', label: 'Experience' },
    { href: '/contact', label: 'Contact' },
]
---

<header class="site-rail">
    <a class="monogram" href="/" aria-label="Daniel Vieira Teixeira, home"
        >DVT</a
    >
    <p class="rail-name" aria-hidden="true">Daniel<br />Vieira<br />Teixeira</p>
    <p class="rail-location">Cape Town,<br />South Africa</p>
    <nav aria-label="Primary navigation">
        {
            links.map(link => (
                <a
                    class={link.href === '/' ? 'nav-home' : undefined}
                    href={link.href}
                    aria-current={
                        currentPath === link.href ? 'page' : undefined
                    }
                >
                    {link.label}
                </a>
            ))
        }
    </nav>
    <img
        class="rail-portrait"
        src={profileImage.src}
        alt=""
        aria-hidden="true"
        loading="eager"
        decoding="async"
    />
</header>

<style lang="scss">
    .site-rail {
        position: fixed;
        z-index: 30;
        inset: 0 auto 0 0;
        width: var(--rail-width);
        display: grid;
        grid-template-rows: auto auto auto 1fr;
        gap: clamp(1rem, 2vh, 1.75rem);
        padding: clamp(1rem, 2vw, 1.45rem) 1.1rem;
        border-right: 1px solid var(--ink);
        background: var(--heritage-cream);
    }

    .site-rail::before {
        position: absolute;
        top: 26.5%;
        left: 50%;
        width: 1px;
        height: 5.5vh;
        min-height: 3rem;
        content: '';
        background: var(--heritage-amber);
        transform: translateX(-50%);
    }

    .monogram {
        width: max-content;
        min-width: var(--touch-target);
        min-height: var(--touch-target);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--ink);
        font-size: clamp(1.45rem, 1.75vw, 1.85rem);
        font-weight: 850;
        line-height: 0.9;
        letter-spacing: -0.04em;
        text-decoration: none;
        transition: color 260ms var(--ease-out);

        &:hover {
            color: var(--signal);
        }
    }

    .rail-name,
    .rail-location {
        position: absolute;
        left: 1.1rem;
        color: var(--ink);
        font-family: var(--font-human);
        font-size: 0.8rem;
        font-weight: 590;
        line-height: 1.04;
    }

    .rail-name {
        top: 8%;
    }
    .rail-location {
        top: 18%;
        font-size: 0.82rem;
    }

    nav {
        position: absolute;
        top: 36%;
        left: 50%;
        display: flex;
        justify-content: flex-start;
        gap: clamp(1.3rem, 4vh, 2.5rem);
        transform: translateX(-50%);
        writing-mode: vertical-rl;
    }

    nav a {
        position: relative;
        min-width: var(--touch-target);
        min-height: var(--touch-target);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.4rem 0.28rem;
        color: var(--ink);
        font-family: var(--font-human);
        font-size: 0.9rem;
        font-weight: 610;
        text-decoration: none;
        transition:
            color 220ms var(--ease-out),
            background-color 220ms var(--ease-out),
            transform 220ms var(--ease-out),
            box-shadow 220ms var(--ease-out);

        &::after {
            position: absolute;
            inset: auto -0.24rem -0.1rem auto;
            width: 0.34rem;
            aspect-ratio: 1;
            content: '';
            border-radius: 50%;
            background: var(--signal);
            opacity: 0;
            transform: scale(0);
            transition:
                opacity 220ms var(--ease-out),
                transform 220ms var(--ease-out);
        }

        &:hover,
        &[aria-current='page'] {
            color: var(--ink);
            background: var(--heritage-amber);
            box-shadow: 2px 2px 0 var(--ink);
            transform: translate(-1px, -1px);
        }

        &[aria-current='page']::after {
            opacity: 1;
            transform: scale(1);
        }
    }

    .nav-home {
        display: none;
    }

    .rail-portrait {
        position: absolute;
        right: 50%;
        bottom: 1.4rem;
        width: 3.65rem;
        aspect-ratio: 1;
        border: 3px solid var(--heritage-cream);
        border-radius: 50%;
        outline: 1px solid var(--ink);
        object-fit: cover;
        filter: grayscale(1) contrast(1.05);
        transform: translateX(50%);
        box-shadow: 4px 4px 0 var(--heritage-amber);
    }

    @media (max-width: 760px) {
        .site-rail {
            inset: 0 0 auto;
            width: 100%;
            height: 4.75rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1rem;
            border-right: 0;
            border-bottom: 1px solid var(--ink);
        }

        .site-rail::before,
        .rail-name,
        .rail-location,
        .rail-portrait {
            display: none;
        }

        .monogram {
            font-size: 1.45rem;
        }

        nav {
            position: fixed;
            z-index: 31;
            top: auto;
            right: auto;
            bottom: calc(0.8rem + env(safe-area-inset-bottom));
            left: 50%;
            width: max-content;
            max-width: calc(100vw - 1.5rem);
            display: flex;
            flex-direction: row;
            justify-content: center;
            gap: 0.15rem;
            padding: 0.48rem;
            background: var(--heritage-amber);
            box-shadow: 3px 3px 0 var(--ink);
            transform: translateX(-50%);
            writing-mode: horizontal-tb;
        }

        .nav-home {
            display: inline-flex;
        }

        nav a {
            padding: 0.4rem clamp(0.42rem, 2.1vw, 0.7rem);
            font-size: clamp(0.74rem, 3vw, 0.86rem);
            white-space: nowrap;
        }

        nav a:hover,
        nav a[aria-current='page'] {
            background: var(--heritage-cream);
            box-shadow: none;
            transform: none;
        }

        nav a::after {
            display: none;
        }
    }
</style>
